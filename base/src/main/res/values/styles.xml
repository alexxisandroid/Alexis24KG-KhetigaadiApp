<resources>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:editTextColor">@color/dark_grey</item>
    </style>
    <style name="PageMenu">
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="homePageLabel">
        <item name="android:textSize">25sp</item>
        <item name="android:padding">12sp</item>
    </style>
    <style name="Widget.BottomNavigationView" parent="Widget.Design.BottomNavigationView">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="textAllCaps">true</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="BottomNavigationView.Active" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textSize">10sp</item>
    </style>
    <style name="BottomNavigationView.InActive" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textSize">10sp</item>
    </style>
    <style name="ItemTitle">
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/dimen_12sp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="ButtonStyleFilledRed" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btn_rectangle_bg_red</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="SearchEditText">
<!--        <item name="android:fontFamily">@font/poppins_medium</item>-->
        <item name="android:textSize">14sp</item>
        <item name="android:backgroundTint">@color/grey_line</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
    </style>
    <style name="SearchBorderEditText" parent="SearchEditText">
        <item name="android:background">@drawable/round_rect_grey_border</item>
        <item name="android:padding">@dimen/dimen_10dp</item>
    </style>
    <style name="CardViewHorizontalListItem">
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>
    <style name="SearchPageHeading" parent="homePageLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:clickable">false</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:focusable">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="backgroundColor">@color/labelBackGround</item>
        <item name="android:textColor">@color/black</item>
<!--        <item name ="fontFamily">@font/poppins_semi_bold</item>  -->
    </style>
    <style name="CardViewListItem">
        <item name="cardElevation">4dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="android:layout_marginTop">@dimen/margin_2dp</item>
    </style>
</resources>
