<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#fffafa"/>
            <corners android:radius="@dimen/margin_10dp"/>
            <stroke
                android:dashGap="2dp"
                android:dashWidth="5dp"
                android:width="1dp"
                android:color="@color/light_grey"/>
            <padding
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp"/>
        </shape>
    </item>
</layer-list>
