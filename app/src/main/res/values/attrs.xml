<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="AvatarImageBehavior">
        <attr name="finalXPosition" format="dimension"/>
        <attr name="finalYPosition" format="dimension"/>
        <attr name="finalHeight" format="dimension"/>
        <attr name="finalToolbarHeight" format="dimension"/>
    </declare-styleable>
    <declare-styleable
        name="HomeMenuOptions">
        <attr name="titleText" format="string" localization="suggested"/>
        <attr name="viewBackgroundColor" format="color"/>
        <attr name="iconImage" format="reference"/>
        <attr name="titleMaxLines" format="integer"/>
        <attr name="android:fontFamily" />

        <attr name="customTextStyle" format="enum">
            <enum name="normal" value="0"/>
            <enum name="bold" value="1"/>
            <enum name="italic" value="2"/>
        </attr>
    </declare-styleable>
</resources>
