<?xml version="1.0" encoding="utf-8"?>
<com.wangjie.rapidfloatingactionbutton.RapidFloatingActionLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:rfal="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main_rfal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    rfal:rfal_frame_alpha="0.5"
    rfal:rfal_frame_color="#000000">
    <com.wangjie.rapidfloatingactionbutton.RapidFloatingActionButton
        xmlns:rfab="http://schemas.android.com/apk/res-auto"
        android:id="@+id/activity_main_rfab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dimen_2dp"
        android:layout_marginBottom="@dimen/payu_dimen_75dp"
        android:padding="6dp"
        rfab:rfab_color_normal="@color/red"
        rfab:rfab_color_pressed="@color/red"
        rfab:rfab_drawable="@drawable/rfab__drawable_rfab_default"
        rfab:rfab_shadow_color="#999999"
        rfab:rfab_shadow_dx="0dp"
        rfab:rfab_shadow_dy="1dp"
        rfab:rfab_shadow_radius="5dp"
        rfab:rfab_size="normal"/>
</com.wangjie.rapidfloatingactionbutton.RapidFloatingActionLayout>