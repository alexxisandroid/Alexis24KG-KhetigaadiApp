<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white"
    android:layout_margin="4dp"
    android:background="@color/rv_back_color">
    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="100dp"
        android:layout_height="@dimen/dimen_80dp"
        android:adjustViewBounds="true"
        android:layout_margin="8dp"
        android:contentDescription="@string/app_name"
        android:padding="@dimen/margin_2dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitXY"
        android:background="@color/detailsBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDiscount"/>
    <TextView
        android:id="@+id/tvDiscount2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:layout_marginEnd="@dimen/dimen_8dp"
        android:background="@drawable/rounded_corner"
        android:fontFamily="@font/manrope_medium"
        android:backgroundTint="@color/offBg"
        android:textAlignment="center"
        android:gravity="center"
        android:paddingStart="@dimen/dimen_5dp"
        android:visibility="invisible"
        android:paddingTop="@dimen/dimen_3dp"
        android:textSize="@dimen/dimen_12sp"
        android:paddingEnd="@dimen/dimen_5dp"
        android:paddingBottom="@dimen/dimen_3dp"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="- 10%"/>

    <TextView
        android:id="@+id/tvDiscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:layout_marginEnd="@dimen/dimen_8dp"
        android:background="@drawable/rounded_corner"
        android:fontFamily="@font/manrope_medium"
        android:backgroundTint="@color/offBg"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginStart="@dimen/dimen_8dp"
        android:paddingStart="@dimen/dimen_5dp"
        android:paddingTop="@dimen/dimen_3dp"
        android:textSize="@dimen/dimen_12sp"
        android:paddingEnd="@dimen/dimen_5dp"
        android:paddingBottom="@dimen/dimen_3dp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="- 10%"/>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_5dp"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:textSize="@dimen/dimen_16sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginEnd="@dimen/dimen_8dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivImage"
        app:layout_constraintTop_toBottomOf="@+id/tvDiscount"
        android:fontFamily="@font/manrope_semibold"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="114dp"
        tools:text="Samsung 192 ltr 2 star dddd RR19M27RJ"/>

    <TextView
        android:id="@+id/tvDiscPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_4dp"
        android:layout_marginBottom="8dp"
         android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="@dimen/dimen_16sp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:fontFamily="@font/manrope_semibold"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        app:layout_constraintStart_toEndOf="@+id/tvPrice"
        app:layout_constraintVertical_bias="1.0"
        tools:text="1000"/>
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_4dp"
        android:layout_marginBottom="@dimen/dimen_5dp"
        android:layout_marginTop="@dimen/margin_10dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/light_grey"
       app:layout_constraintTop_toBottomOf="@+id/tvName"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="10100"/>
    <TextView
        android:id="@+id/tvDiscPer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_5dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="@dimen/dimen_5dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/greenHaze"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvDiscPrice"
        app:layout_constraintVertical_bias="1.0"
        tools:text=""/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="@dimen/margin_5dp"
        android:layout_marginStart="@dimen/dimen_2dp"
        android:layout_marginBottom="@dimen/margin_5dp"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        app:layout_constraintEnd_toStartOf="@id/ivImage">
        <TextView
            android:id="@+id/tvQuantityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/qty"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/black"
            android:textSize="@dimen/dimen_12sp"
            android:textStyle="bold"
            android:fontFamily="@font/manrope_semibold"
            app:layout_constraintBottom_toBottomOf="@id/tvPlus"
            app:layout_constraintRight_toLeftOf="@+id/tvMinus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvPlus"/>
        <TextView
            android:id="@+id/tvMinus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="8dp"
            android:paddingStart="@dimen/dimen_0dp"
            android:text="@string/minus"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvQuantity"
            app:layout_constraintStart_toEndOf="@id/tvQuantityLabel"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_1"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/tvPlus"
            app:layout_constraintRight_toLeftOf="@+id/tvPlus"
            app:layout_constraintTop_toTopOf="@id/tvPlus"/>
        <TextView
            android:id="@+id/tvPlus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingEnd="@dimen/margin_8dp"
            android:text="@string/plus"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>