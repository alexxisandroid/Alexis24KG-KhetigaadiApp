<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/container"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="225dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <me.relex.circleindicator.CircleIndicator
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:ci_drawable="@drawable/ic_circle_red_24dp"
            app:ci_drawable_unselected="@drawable/ic_circle_black_24dp"
            app:ci_height="6dp"
            app:ci_margin="@dimen/dimen_4dp"
            app:ci_width="6dp"
            app:layout_constraintTop_toBottomOf="@id/viewPager"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvSearchByName"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/indicator">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10dp">
                <TextView
                    style="@style/SearchPageHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dimen_8dp"
                    android:text="@string/search_implement_by_name"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black" />
                <EditText
                    android:id="@+id/edSearchImpByName"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:drawableStart="@drawable/search_symbol"
                    android:focusableInTouchMode="false"
                    android:hint="@string/type_to_select_implement_name"
                    android:longClickable="false"
                    app:layout_constraintTop_toBottomOf="@+id/searchByBrand"
                    android:autofillHints="searchbyImpByName"
                    android:inputType="text" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/tvOrLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_40dp"
            android:layout_marginEnd="@dimen/margin_20dp"
            android:layout_weight="1"
            android:background="@color/navy_blue"
            app:layout_constraintBottom_toBottomOf="@id/tvOr"
            app:layout_constraintEnd_toStartOf="@+id/tvOr"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvOr" />
        <TextView
            android:id="@+id/tvOr"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/margin_20dp"
            android:background="@drawable/rounded_corner_btn_with_light_color"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/or"
            android:textAllCaps="true"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@+id/tvOrLine1"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvOrLine"
            app:layout_constraintTop_toBottomOf="@id/cvSearchByName" />
        <TextView
            android:id="@+id/tvOrLine1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_20dp"
            android:layout_marginEnd="@dimen/margin_40dp"
            android:background="@color/navy_blue"
            app:layout_constraintBottom_toBottomOf="@id/tvOr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvOr"
            app:layout_constraintTop_toTopOf="@id/tvOr" />
        <TextView
            android:id="@+id/tvDoYouHaveLabel"
            style="@style/homePageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/do_you_have_a_implement_in_mind"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvOr" />
        <androidx.cardview.widget.CardView
            android:id="@+id/cvBrandModel"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/tvDoYouHaveLabel">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10dp">
                <TextView
                    android:id="@+id/searchByBrand"
                    style="@style/SearchPageHeading"
                    android:layout_width="match_parent"
                    android:padding="@dimen/dimen_8dp"
                    android:layout_height="wrap_content"
                    android:text="@string/search_by_brand_and_type"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent" />
                <EditText
                    android:id="@+id/et_brand"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:hint="@string/brand"
                    android:inputType="text"
                    android:longClickable="false"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    app:layout_constraintTop_toBottomOf="@+id/searchByBrand"
                    android:autofillHints="brand" />
                <EditText
                    android:id="@+id/etType"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:backgroundTint="@color/grey_line"
                    android:clickable="true"
                    android:focusable="true"
                    android:hint="@string/type"
                    android:inputType="text"
                    android:longClickable="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/et_brand"
                    android:autofillHints="type" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvSearchByHP"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@+id/cvBrandModel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SearchPageHeading"
                    android:layout_width="wrap_content"
                    android:padding="@dimen/dimen_8dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hp"
                    android:textColor="@color/black" />


                <EditText
                    android:id="@+id/et_hp"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/select_hp"
                    android:inputType="text"
                    android:longClickable="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/til_brand"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@+id/cvSearchByHP">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/SearchPageHeading"
                    android:layout_width="match_parent"
                    android:id="@+id/tvBrandLabel"
                    android:padding="@dimen/dimen_8dp"
                    android:layout_height="wrap_content"
                    android:text="@string/search_by_brand"/>
                <LinearLayout
                    android:id="@+id/llBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>