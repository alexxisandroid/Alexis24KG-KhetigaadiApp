<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clFastMovingProduct"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/dimen_20dp"

    android:background="@color/pageBackGround">
    <TextView
        android:id="@+id/tvSimilarProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_15dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginEnd="8dp"
        android:text="@string/similar_product"
        android:textAllCaps="true"
        android:textColor="@color/dark_grey"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProductList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/margin_10dp"
        android:backgroundTint="@color/rv_back_color"
        android:visibility="visible"
        android:background="@drawable/rounded_corner22"
        android:paddingStart="@dimen/dimen_4dp"
        android:paddingEnd="@dimen/dimen_2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSimilarProduct"/>
</androidx.constraintlayout.widget.ConstraintLayout>