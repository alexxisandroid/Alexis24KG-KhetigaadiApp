<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dimen_5dp"
            android:backgroundTint="@color/white"
            android:background="@color/white">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10dp"
                android:weightSum="1">
                 <!--  messenger_button_white_bg_selector  detailsBackground   -->
                <ImageView
                    android:id="@+id/ivImage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/payu_dimen_250dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="@drawable/messenger_button_white_bg_selector"
                    android:contentDescription="@string/app_name"
                    android:backgroundTint="@color/detailsBackground"
                    android:src="@mipmap/ic_launcher"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvViews"
                    style="@style/ViewsRoundedSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginTop="@dimen/dimen_10dp"
                    android:layout_marginStart="@dimen/dimen_10dp"
                    android:gravity="start|center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="0k"/>
                <ImageView
                    android:id="@+id/ivFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/payu_dimen_7dp"
                    android:layout_marginEnd="15dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_favorites_border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                    <!-- style="@style/TractorListItemTitle" -->
                <TextView
                    android:id="@+id/tvTractorName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"
                    android:maxLines="2"
                    android:paddingTop="@dimen/margin_5dp"
                    android:layout_marginEnd="@dimen/margin_10dp"
                    android:layout_marginStart="@dimen/dimen_5dp"
                    style="@style/homePageLabelTl"
                    android:layout_alignParentEnd="true"
                    android:textStyle="bold"
                    android:paddingEnd="@dimen/dimen_30dp"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@+id/ivDrive"
                    android:textSize="@dimen/dimen_16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivImage"
                    tools:text="Same Deutz Fahr Agrolux 80 Profiline vbbcbcv bvcxvxcvcxv cxv xcvcxvcxv"/>
                <TextView
                    android:id="@+id/tvReview"
                    style="@style/ListFieldWithDrawable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:paddingStart="@dimen/margin_15dp"
                    android:text="@string/write_review"
                    android:textColor="@color/greenHaze"
                    android:textSize="@dimen/dimen_14sp"
                    android:visibility="invisible"
                    app:layout_constraintTop_toBottomOf="@id/tvTractorName" />
                <ImageView
                    android:id="@+id/ivDrive"
                    android:layout_width="@dimen/dimen_28dp"
                    android:layout_height="@dimen/dimen_28dp"
                    android:layout_marginEnd="@dimen/payu_dimen_12dp"
                    android:src="@drawable/ic_2wd"
                    android:layout_marginBottom="@dimen/dimen_10dp"
                    android:layout_marginTop="@dimen/margin_10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvTractorName"
                    app:layout_constraintTop_toBottomOf="@+id/ivImage"/>
                <ImageView
                    android:id="@+id/ivShare"
                    android:layout_width="@dimen/payu_dimen_24dp"
                    android:layout_height="@dimen/payu_dimen_24dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/ic_share_black_24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTractorName" />
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvDetails"
                    style="@style/CardViewListItem"
                    android:layout_width="match_parent"
                    android:background="@color/white"
                    android:backgroundTint="@color/white"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/ivShare">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:background="@color/pageBackGround"
                        android:padding="@dimen/margin_5dp">
                        <androidx.constraintlayout.helper.widget.Flow
                            android:id="@+id/flow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_10dp"
                            android:paddingStart="@dimen/margin_15dp"
                            android:layout_marginBottom="@dimen/dimen_10dp"
                            app:constraint_referenced_ids="tvHP,tvDisplacementCC,tvNoOfCylinder,tvPTO"
                            app:flow_maxElementsWrap="2"
                            app:flow_wrapMode="aligned"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                        <TextView
                            android:id="@+id/tvHP"
                            style="@style/ListFieldWithDrawable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_marginBottom="5dp"
                            android:textStyle="bold"
                            android:drawablePadding="@dimen/dimen_3dp"
                            android:gravity="center|start"
                            android:textAlignment="textStart"
                            android:fontFamily="@font/poppins_semibold"
                            android:padding="@dimen/margin_5dp"
                            app:drawableStartCompat="@drawable/ic_hp_24"
                            tools:text="45 HP"
                            app:drawableTint="@color/black" />
                        <TextView
                            android:id="@+id/tvDisplacementCC"
                            style="@style/ListFieldWithDrawable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginStart="15dp"
                            android:textStyle="bold"
                            android:drawablePadding="@dimen/dimen_3dp"
                            android:gravity="center|start"
                            android:textAlignment="textStart"
                            android:layout_marginBottom="5dp"
                            android:padding="@dimen/margin_5dp"
                            app:drawableStartCompat="@drawable/ic_engine_cc_24"
                            tools:text="44 CC"
                            app:drawableTint="@color/black" />
                        <TextView
                            android:id="@+id/tvNoOfCylinder"
                            style="@style/ListFieldWithDrawable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginStart="15dp"
                            android:layout_marginBottom="5dp"
                            android:drawablePadding="@dimen/dimen_3dp"
                            android:textStyle="bold"
                            android:padding="@dimen/margin_5dp"
                            app:drawableStartCompat="@drawable/ic_cylinder_24"
                            tools:text="4 Cylinder"
                            app:drawableTint="@color/black" />
                        <TextView
                            android:id="@+id/tvPTO"
                            style="@style/ListFieldWithDrawable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:textStyle="bold"
                            android:layout_marginBottom="5dp"
                            android:drawablePadding="@dimen/dimen_3dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:padding="@dimen/margin_5dp"
                            app:drawableStartCompat="@drawable/ic_pto_hp_24"
                            tools:text="66 PTO"
                            app:drawableTint="@color/black" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <include
                    android:id="@+id/includeSimilar"
                    layout="@layout/home_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_4dp"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cvDetails"
                    tools:visibility="visible"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/progressBar"
        layout="@layout/progressbar"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
