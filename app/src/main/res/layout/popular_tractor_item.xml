<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    style="@style/CardViewHorizontalListItem"
    app:cardUseCompatPadding="true"
    android:layout_width="wrap_content"
    app:cardCornerRadius="@dimen/dimen_4dp"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="260dp"
        android:layout_height="@dimen/payu_dimen_280dp"
        android:background="@color/detailsBackground">
        <ImageView
            android:id="@+id/popularTractorImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:scaleType="fitXY"
            android:background="@color/white"
            android:padding="@dimen/margin_5dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toTopOf="@id/popularTractorTitle"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/tractor_image"/>
        <TextView
            android:id="@+id/tvViews"
            style="@style/ViewsRoundedSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:textAlignment="center"
            android:gravity="start|center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="0k"/>
        <TextView
            android:id="@+id/popularTractorTitle"
            style="@style/TractorListItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:maxLines="1"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/dimen_10dp"
            android:fontFamily="@font/poppins_bold"
            android:textSize="@dimen/dimen_16sp"
            app:layout_constraintBottom_toTopOf="@id/tvHP"
            tools:text=" Sonalika DI 47 Rx (MahSnecial)"/>
        <TextView
            android:id="@+id/tvHP"
            style="@style/ItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginBottom="@dimen/payu_dimen_6dp"
            app:layout_constraintBottom_toTopOf="@id/btnGetOnRoadPrice"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="45 HP"/>
        <TextView
            android:id="@+id/tvPrice"
            style="@style/ItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_15dp"
            android:layout_marginBottom="5dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btnGetOnRoadPrice"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="6-7 Lakh"
            tools:visibility="visible"/>
        <!--  style="@style/OutLineButtonStyleSmall"  -->
        <TextView
            android:id="@+id/btnGetOnRoadPrice"
            android:layout_width="match_parent"
            android:fontFamily="@font/poppins_medium"
            android:layout_height="@dimen/payu_dimen_38dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:textColor="@color/red"
            android:textAlignment="center"
            android:outlineAmbientShadowColor="@color/red"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:text="@string/getOnRoadPrice"
            android:textSize="@dimen/dimen_14sp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>