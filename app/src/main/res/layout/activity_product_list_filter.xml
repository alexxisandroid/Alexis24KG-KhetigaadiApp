<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ecom.list.ProductListFilterActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/payu_dimen_63dp"
        android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_above="@+id/ccccc"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cvSearchByCategory"
                style="@style/CardViewListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="@dimen/margin_10dp"
                android:visibility="visible"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/margin_10dp">
                    <TextView
                        android:id="@+id/tvCategoryLabel"
                        style="@style/SearchPageHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/search_by_category"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/rangeBarPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100"
                        app:values="@array/initial_slider_values"
                        app:labelBehavior="withinBounds"
                        app:layout_constraintTop_toBottomOf="@id/tvCategoryLabel"/>
                    <LinearLayout
                        android:id="@+id/llcxv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        android:layout_marginStart="@dimen/dimen_10dp"
                        app:layout_constraintTop_toBottomOf="@id/rangeBarPrice"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvMinPrice"
                            android:layout_width="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/tvMaxPrice"
                            android:layout_width="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/etCategory"
                        style="@style/SearchBorderEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/payu_dimen_54dp"
                        android:layout_marginStart="@dimen/margin_10dp"
                        android:layout_marginEnd="@dimen/margin_10dp"
                        android:layout_marginTop="@dimen/dimen_16dp"
                        android:hint="@string/category"
                        android:inputType="text"
                        android:longClickable="false"
                        app:layout_constraintTop_toBottomOf="@id/llcxv"
                        android:autofillHints=""/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCategories"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="@dimen/dimen_10dp"
                        android:paddingStart="@dimen/dimen_10dp"
                        android:paddingEnd="@dimen/dimen_10dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/etCategory"
                        tools:listitem="@layout/filter_list_sub_item_new"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ccccc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="5sp"
        android:minHeight="@dimen/dimen_30dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="@dimen/margin_5dp"
        tools:visibility="visible">
        <TextView
            android:id="@+id/btnClearAll"
            android:layout_width="0dp"
            android:layout_height="@dimen/payu_dimen_45dp"
            android:layout_margin="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:text="@string/clear_all"
            android:visibility="visible"

            android:minHeight="@dimen/payu_dimen_45dp"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:textAlignment="center"
            android:textColor="@color/red"
              android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnApplyFilter"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible"/>
        <TextView
            android:id="@+id/btnApplyFilter"
            android:layout_width="0dp"
            android:layout_height="@dimen/payu_dimen_45dp"
            android:layout_margin="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:autoLink="web"
            android:text="@string/apply_filters"
            android:gravity="center"

            android:minHeight="@dimen/payu_dimen_45dp"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:textAlignment="center"
            android:textColor="@color/red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/btnClearAll"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>