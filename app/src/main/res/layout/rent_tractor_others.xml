<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".tractor.rent.rentTractorNewUi.RentTractorOther">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar" />
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <include
            android:id="@+id/tabOther"
            layout="@layout/nav_tab_rent"/>
        <View
            android:id="@+id/doc_view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_line"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/FormTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:padding="10dp"
                    android:text="@string/working_area"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/btn_selector"
                    android:orientation="horizontal"
                    android:padding="10dp">
                    <EditText
                        android:id="@+id/et_working_radius"
                        style="@style/FormEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/payu_dimen_54dp"
                        android:layout_weight=".2"
                        android:hint="@string/working_area"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="7"
                        android:padding="10dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight=".8"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="top"
                        android:padding="5dp"
                        android:text="@string/km"
                        android:textColor="@color/ValueGrey" />
                </androidx.appcompat.widget.LinearLayoutCompat>
                <TextView
                    style="@style/FormTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:padding="10dp"
                    android:text="@string/note"
                    android:textColor="@color/black" />
                <EditText
                    android:id="@+id/et_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/btn_selector"
                    android:fontFamily="@font/poppins_medium"
                    android:hint="@string/pleaseAddNote"
                    android:inputType="textMultiLine"
                    android:maxLength="100"
                    android:maxLines="5"
                    android:padding="10dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <TextView
        android:id="@+id/btnSubmit"
        style="@style/ButtonStyleFilledRed"
        android:layout_width="match_parent"
        android:background="@color/red"
        android:layout_height="@dimen/dimen_50dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:textColor="@color/white"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/btn_submit" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>