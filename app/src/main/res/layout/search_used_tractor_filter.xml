<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".tractor.usedTractor.search.SearchUsedTractorFilter">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/dimen_50dp"
        android:background="@color/pageBackGround">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="225dp"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="0dp"/>

        <me.relex.circleindicator.CircleIndicator
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:ci_drawable="@drawable/ic_circle_red_24dp"
            app:ci_drawable_unselected="@drawable/ic_circle_black_24dp"
            app:ci_height="6dp"
            app:ci_margin="@dimen/dimen_4dp"
            app:ci_width="6dp"
            app:layout_constraintTop_toBottomOf="@id/viewPager"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvSearchByName"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:background="@color/white"
            android:backgroundTint="@color/white"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/indicator">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10dp">
                <TextView
                    style="@style/SearchPageHeading"
                    android:layout_width="wrap_content"
                    android:padding="@dimen/dimen_8dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/search_tractor_by_name"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black"/>
                <EditText
                    android:id="@+id/edSearchTractorByName"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:focusableInTouchMode="false"
                    android:hint="@string/type_to_select_name"
                    android:longClickable="false"
                    app:layout_constraintTop_toBottomOf="@+id/searchByBrand"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/tvOrLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_40dp"
            android:layout_marginEnd="@dimen/margin_20dp"
            android:layout_weight="1"
            android:background="@color/navy_blue"
            app:layout_constraintBottom_toBottomOf="@id/tvOr"
            app:layout_constraintEnd_toStartOf="@+id/tvOr"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvOr"/>
        <TextView
            android:id="@+id/tvOr"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/margin_20dp"
            android:background="@drawable/rounded_corner_btn_with_light_color"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/or"
            android:textAllCaps="true"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@+id/tvOrLine1"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvOrLine"
            app:layout_constraintTop_toBottomOf="@id/cvSearchByName"/>
        <TextView
            android:id="@+id/tvOrLine1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_20dp"
            android:layout_marginEnd="@dimen/margin_40dp"
            android:background="@color/navy_blue"
            app:layout_constraintBottom_toBottomOf="@id/tvOr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvOr"
            app:layout_constraintTop_toTopOf="@id/tvOr"/>
        <TextView
            android:id="@+id/tvDoYouHaveLabel"
            style="@style/homePageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/do_you_have_a_tractor_in_mind"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvOr"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvBrandModel"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:background="@color/white"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/tvDoYouHaveLabel">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10dp">
                <TextView
                    android:id="@+id/searchByBrand"
                    style="@style/SearchPageHeading"
                    android:padding="@dimen/dimen_8dp"
                    android:layout_width="match_parent"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_height="wrap_content"
                    android:text="@string/search_by_brand_and_model"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"/>
                <EditText
                    android:id="@+id/etBrand"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/brand"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:inputType="text"
                    android:longClickable="false"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    app:layout_constraintTop_toBottomOf="@+id/searchByBrand"/>
                <EditText
                    android:id="@+id/etModel"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:backgroundTint="@color/grey_line"
                    android:clickable="true"
                    android:focusable="false"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:hint="@string/model"
                    android:inputType="text"
                    android:longClickable="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/etBrand"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvPrice"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:background="@color/white"
            android:backgroundTint="@color/white"
            android:layout_marginRight="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/cvBrandModel">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10dp">
                <TextView
                    android:id="@+id/searchByPrice"
                    style="@style/SearchPageHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price_range"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:padding="@dimen/dimen_8dp"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvMinPrice"
                    style="@style/SearchPageHeading"
                    android:layout_width="wrap_content"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@+id/tvDash"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/searchByPrice"
                    tools:text="10 K"/>
                <TextView
                    android:id="@+id/tvDash"
                    style="@style/SearchPageHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/dash"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@+id/tvMaxPrice"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvMinPrice"
                    app:layout_constraintTop_toBottomOf="@id/searchByPrice"/>
                <TextView
                    android:id="@+id/tvMaxPrice"
                    style="@style/SearchPageHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvDash"
                    app:layout_constraintTop_toBottomOf="@id/searchByPrice"
                    tools:text="15 L"/>
                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/rangeBarPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    style="@style/Myslider"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/search_by_price"
                    android:stepSize="1"
                    android:valueFrom="0"
                    app:labelBehavior="floating"
                    android:valueTo="38"
                    app:layout_constraintTop_toBottomOf="@id/tvMaxPrice"
                    app:thumbColor="@color/red"
                    app:tickColor="@color/red"
                    app:trackColor="@color/red"/>
                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    app:layout_constraintTop_toBottomOf="@id/rangeBarPrice">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio10To2"
                        style="@style/Widget.App.RadioButton.OutLine"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="@dimen/dimen_5dp"
                        android:layout_weight="1"
                        android:text="@string/_10k_2l"
                        android:fontFamily="@font/poppins_bold"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        tools:checked="false"/>
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio2To3"
                        style="@style/Widget.App.RadioButton.OutLine"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="@dimen/dimen_5dp"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/_2_3l"
                        android:textSize="12sp"/>
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio3To5"
                        style="@style/Widget.App.RadioButton.OutLine"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="@dimen/dimen_5dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_bold"
                        android:textStyle="bold"
                        android:text="@string/_3_5l"
                        android:textSize="12sp"/>
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioAbove5"
                        style="@style/Widget.App.RadioButton.OutLine"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="@dimen/dimen_5dp"
                        android:layout_weight="1"
                        android:padding="3dp"
                        android:fontFamily="@font/poppins_bold"
                        android:textStyle="bold"
                        android:text="@string/above_5l"
                        android:textSize="12sp"/>
                </RadioGroup>
                <!--  style="@style/OutLineButtonStyleSmall" -->
                <TextView
                    android:id="@+id/btnSearchUsedTractor"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_40dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/dimen_20dp"
                    android:layout_marginTop="@dimen/dimen_15dp"
                    android:textStyle="bold"
                    android:textColor="@color/red"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:outlineAmbientShadowColor="@color/red"
                    android:background="@drawable/btn_rectangle_outline_bg_red"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:text="@string/search"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/radioGroup"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:backgroundTint="@color/white"
            android:background="@color/white"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@+id/cvPrice">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/SearchPageHeading"
                    android:id="@+id/tvHeading"
                    android:padding="@dimen/dimen_8dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_by_brand"/>
                <LinearLayout
                    android:id="@+id/llBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>