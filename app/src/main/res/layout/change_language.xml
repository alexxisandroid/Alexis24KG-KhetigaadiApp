<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btnDone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioGroup
                    android:id="@+id/rgLanguages"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="10"
                    android:inputType="text"
                    android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbEnglish"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:layout_marginStart="20dp"
                        android:fontFamily="@font/poppins_medium"
                        android:buttonTint="@color/white"
                        android:drawableEnd="@drawable/english"
                        android:drawablePadding="40dp"
                        android:layoutDirection="rtl"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="@string/english"
                        android:textAlignment="textStart"
                        android:textSize="18sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/darkGrey"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbHindi"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginStart="20dp"
                        android:buttonTint="@color/white"
                        android:drawableEnd="@drawable/hindi"
                        android:drawablePadding="52dp"
                        android:layoutDirection="rtl"
                        android:paddingEnd="20dp"
                        android:paddingStart="@dimen/dimen_4dp"
                        android:text="@string/hindi"
                        android:textAlignment="textStart"
                        android:textSize="18sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/darkGrey"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbMarathi"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginStart="20dp"
                        android:buttonTint="@color/white"
                        android:drawableEnd="@drawable/marathi"
                        android:drawablePadding="50dp"
                        android:layoutDirection="rtl"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="@string/marathi"
                        android:textAlignment="textStart"
                        android:textSize="18sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/darkGrey"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbGujarati"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:layout_marginStart="20dp"
                        android:fontFamily="@font/poppins_medium"
                        android:buttonTint="@color/white"
                        android:drawableEnd="@drawable/gujarati"
                        android:drawablePadding="50dp"
                        android:layoutDirection="rtl"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="@string/gujarati"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        android:visibility="visible"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/darkGrey"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbTelugu"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:layout_marginStart="20dp"
                        android:fontFamily="@font/poppins_medium"
                        android:buttonTint="@color/white"
                        android:drawableEnd="@drawable/telugu"
                        android:drawablePadding="32dp"
                        android:layoutDirection="rtl"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="@string/telugu"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        android:visibility="visible"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/darkGrey"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbTamil"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginStart="20dp"
                        android:buttonTint="@color/white"
                        android:drawableEnd="@drawable/tamil"
                        android:drawablePadding="35dp"
                        android:layoutDirection="rtl"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="@string/tamil"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        android:visibility="visible"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/darkGrey"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbKannada"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:layout_marginStart="20dp"
                        android:fontFamily="@font/poppins_medium"
                        android:buttonTint="@color/white"
                        android:drawableEnd="@drawable/kannada"
                        android:drawablePadding="40dp"
                        android:layoutDirection="rtl"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="@string/kannada"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        android:visibility="visible"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/darkGrey"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbPunjabi"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:layout_marginStart="20dp"
                        android:buttonTint="@color/white"
                        android:fontFamily="@font/poppins_medium"
                        android:drawableEnd="@drawable/punjabi"
                        android:drawablePadding="52dp"
                        android:layoutDirection="rtl"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="@string/punjabi"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        android:visibility="visible"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/darkGrey"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbBangali"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:layout_marginStart="20dp"
                        android:fontFamily="@font/poppins_medium"
                        android:buttonTint="@color/white"
                        android:drawableEnd="@drawable/bangali"
                        android:drawablePadding="48dp"
                        android:layoutDirection="rtl"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="@string/bangali"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        android:visibility="visible"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/darkGrey"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rbMalayalam"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="start"
                        android:layout_marginStart="20dp"
                        android:buttonTint="@color/white"
                        android:fontFamily="@font/poppins_medium"
                        android:drawableEnd="@drawable/malayalam"
                        android:drawablePadding="15dp"
                        android:layoutDirection="rtl"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="@string/malayalam"
                        android:textAlignment="textStart"
                        android:textSize="18sp"
                        android:visibility="visible"/>
                </RadioGroup>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/darkGrey"
                    android:visibility="visible"/>
            </LinearLayout>
        </ScrollView>
        <!--  style="@style/ButtonStyleFilledRed"  -->
        <TextView
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_alignParentBottom="true"
            android:text="@string/apply"
            android:fontFamily="@font/poppins_bold"
            android:layout_height="@dimen/payu_dimen_45dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:textColor="@color/red"
            android:textAlignment="center"
            android:outlineAmbientShadowColor="@color/red"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:textSize="@dimen/dimen_16sp"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>