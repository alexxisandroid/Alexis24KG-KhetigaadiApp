<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:id="@+id/llModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp">

                <TextView
                    android:id="@+id/tvModel"
                    style="@style/ListFieldWithDrawable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:maxLines="10"
                    android:paddingStart="@dimen/margin_15dp"
                    android:paddingEnd="@dimen/dimen_4dp"
                    android:text="@string/dash"
                    android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                <TextView
                    style="@style/ListFieldWithDrawable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/tractor_model"
                    android:textAppearance="?android:attr/textAppearanceListItemSmall"
                    android:textColor="@color/spinnerRowText" />

                <TextView
                    android:id="@+id/tvModel1"
                    style="@style/ListFieldWithDrawable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="10"
                    android:text="@string/dash"
                    android:textAppearance="?android:attr/textAppearanceListItemSmall" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDrive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="35dp"
                    android:layout_marginRight="35dp"
                    android:background="@color/darkGrey"
                    android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDrive"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="10"
                        android:text="@string/dash"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        style="@style/ListFieldWithDrawable"
                        android:text="@string/tractor_drive"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall"
                        android:textColor="@color/spinnerRowText" />

                    <TextView
                        android:id="@+id/tvDrive1"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dash"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="35dp"
                    android:layout_marginRight="35dp"
                    android:background="@color/darkGrey"
                    android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:id="@+id/llTr1Color"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:gravity="center"
                            style="@style/ListFieldWithDrawable"
                            android:text="@string/tractor_color"
                            android:textAppearance="?android:attr/textAppearanceListItemSmall"
                            android:textColor="@color/spinnerRowText" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llTr2Color"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">


                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="35dp"
                    android:layout_marginRight="35dp"
                    android:background="@color/darkGrey"
                    android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHp"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="10"
                        android:text="@string/dash"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        style="@style/ListFieldWithDrawable"
                        android:text="@string/tractor_hp"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall"
                        android:textColor="@color/spinnerRowText" />

                    <TextView
                        android:id="@+id/tvHp1"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="10"
                        android:text="@string/dash"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPTOHp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="35dp"
                    android:layout_marginRight="35dp"
                    android:background="@color/darkGrey"
                    android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPTOHp"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dash"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        style="@style/ListFieldWithDrawable"
                        android:text="@string/pto_hp"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall"
                        android:textColor="@color/spinnerRowText" />

                    <TextView
                        android:id="@+id/tvPTOHp1"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dash"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPTORpm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="35dp"
                    android:layout_marginRight="35dp"
                    android:background="@color/darkGrey"
                    android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPTORpm"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dash"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        style="@style/ListFieldWithDrawable"
                        android:text="@string/pto_rpm"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall"
                        android:textColor="@color/spinnerRowText" />

                    <TextView
                        android:id="@+id/tvPTORpm1"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dash"
                        android:textAppearance="?android:attr/textAppearanceListItemSmall" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>