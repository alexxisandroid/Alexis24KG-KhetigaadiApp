<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="false"
    android:layout_marginBottom="@dimen/payu_dimen_72dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/rounded_corner22"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    android:backgroundTint="@color/white"
    android:layout_marginTop="@dimen/payu_dimen_14dp"
    android:layout_margin="@dimen/dimen_3dp"
    android:weightSum="5">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/userChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:layout_marginEnd="@dimen/dimen_10dp"
        android:layout_marginBottom="@dimen/dimen_2dp"
        android:layout_weight="1">
        <androidx.cardview.widget.CardView
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/white"
            android:backgroundTint="@color/white"
            android:layout_weight="1"
            app:cardUseCompatPadding="true"
            android:layout_marginEnd="@dimen/dimen_4dp"
            app:cardCornerRadius="@dimen/dimen_10dp"
            android:orientation="vertical">
            <com.andexert.library.RippleView
                android:id="@+id/rvUploadedTractor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/cerulean"
                    android:orientation="vertical">
                    <ProgressBar
                        android:id="@+id/PrUploadedCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvUploadedCount"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/_0_"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:textSize="@dimen/dimen_12sp"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="@string/uploaded_old_tractor"
                        android:textAppearance="?android:attr/textAppearance"
                        android:textColor="@color/white" />

                </LinearLayout>

            </com.andexert.library.RippleView>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:cardUseCompatPadding="true"
            android:backgroundTint="@color/white"
            android:background="@color/white"
            android:layout_marginStart="@dimen/dimen_4dp"
            app:cardCornerRadius="@dimen/dimen_10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.andexert.library.RippleView
                android:id="@+id/rvSoldTractor"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/greenHaze"
                    android:orientation="vertical">

                    <ProgressBar
                        android:id="@+id/PrSoldCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvSoldCount"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/_0_"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="@dimen/dimen_12sp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/sold_old_tractor"
                        android:textColor="@color/white" />
                </LinearLayout>


            </com.andexert.library.RippleView>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/dimen_10dp"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:layout_marginTop="@dimen/dimen_2dp"
        android:layout_marginBottom="@dimen/dimen_50dp"
        android:layout_weight="1">

        <androidx.cardview.widget.CardView
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:cardUseCompatPadding="true"
            android:background="@color/white"
            android:backgroundTint="@color/white"
            android:layout_marginEnd="@dimen/dimen_4dp"
            app:cardCornerRadius="@dimen/dimen_10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.andexert.library.RippleView
                android:id="@+id/rvPendingSell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/punch"
                    android:orientation="vertical">
                    <ProgressBar
                        android:id="@+id/PrPending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="gone"/>
                    <TextView
                        android:id="@+id/tvPending"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/_0_"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/white"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="@dimen/dimen_12sp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/pending_sell_tractor"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/white"/>
                </LinearLayout>
            </com.andexert.library.RippleView>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:cardCornerRadius="@dimen/dimen_10dp"
            android:backgroundTint="@color/white"
            android:background="@color/white"
            app:cardUseCompatPadding="true"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:orientation="vertical">
            <com.andexert.library.RippleView
                android:id="@+id/rvRentTr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/buttercup"
                    android:orientation="vertical">
                    <ProgressBar
                        android:id="@+id/PrRentTr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="gone"/>
                    <TextView
                        android:id="@+id/tvRentTr"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/_0_"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:textSize="@dimen/dimen_12sp"
                        android:text="@string/uploaded_rent_tractor"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/white" />
                </LinearLayout>
            </com.andexert.library.RippleView>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>