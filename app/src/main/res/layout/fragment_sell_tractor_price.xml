<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".tractor.sellTractorNewUi.SellTractorPrice">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_marginBottom="60dp"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvRegistrationNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:padding="10dp"
                android:text="@string/rto_registration_number"
                android:textColor="@color/ValueGrey"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_registration_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minHeight="@dimen/payu_dimen_54dp"
                android:layout_marginEnd="10dp"
                android:hint="@string/registration"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLength="20"
                app:layout_constraintTop_toBottomOf="@id/tvRegistrationNo" />

            <TextView
                android:id="@+id/tvExpectedPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:padding="10dp"
                android:text="@string/hint_exPrice"
                android:textColor="@color/ValueGrey"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/et_registration_no" />

            <EditText
                android:id="@+id/et_expected_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minHeight="@dimen/payu_dimen_54dp"
                android:layout_marginEnd="10dp"
                android:hint="@string/price"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="7"
                app:layout_constraintTop_toBottomOf="@id/tvExpectedPrice" />

            <TextView
                android:id="@+id/tvAboutUs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:padding="10dp"
                android:text="@string/about_us"
                android:textColor="@color/ValueGrey"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/et_expected_price" />

            <EditText
                android:id="@+id/et_about_us"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:minHeight="@dimen/payu_dimen_54dp"
                android:inputType="textMultiLine"
                android:maxLength="150"
                android:minLines="1"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAboutUs"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_update_sell_tractor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@color/red"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/btn_submit"
                android:textColor="@color/white"
                android:textSize="15sp"/>
        </androidx.cardview.widget.CardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>