<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".tractor.usedTractor.UsedTractorDetailActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/margin_50dp"
        android:visibility="visible"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/margin_10dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewpager2"
                    android:layout_width="match_parent"
                    android:layout_height="267dp"
                    app:layout_constraintTop_toTopOf="parent">
                </androidx.viewpager2.widget.ViewPager2>
                <me.relex.circleindicator.CircleIndicator3
                    android:id="@+id/indicator"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:ci_drawable="@drawable/ic_circle_red_24dp"
                    app:ci_drawable_unselected="@drawable/ic_circle_black_24dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <ImageView
                    android:id="@+id/ivSold"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/sold_tag"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="gone"/>
                <TextView
                    android:id="@+id/tvViews"
                    style="@style/ViewsRoundedSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginTop="@dimen/dimen_10dp"
                    android:layout_marginStart="@dimen/dimen_10dp"
                    android:gravity="start|center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="0k"/>
                <ImageView
                    android:id="@+id/ivFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/ic_favorites_border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cvCapacitySpecification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/detailsBackground"
                    android:paddingBottom="5dp">
                    <TextView
                        android:id="@+id/tvTractorName"
                        style="@style/MainTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:minLines="1"
                        android:paddingTop="@dimen/margin_5dp"
                        android:paddingEnd="@dimen/margin_5dp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_bold"
                        android:paddingStart="@dimen/dimen_15dp"
                        app:layout_constraintBottom_toTopOf="@id/tvPrice"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Same Deutz Fahr Agrolux 80 Profiline"/>
                    <ImageView
                        android:id="@+id/ivShare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginEnd="15dp"
                        android:src="@drawable/share_normal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTractorName"
                        android:contentDescription="@string/share"/>
                    <TextView
                        android:id="@+id/tvReportAds"
                        style="@style/SubFieldWithDrawable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="@dimen/dimen_10dp"
                        android:visibility="gone"
                        android:text="@string/report_ad"
                        app:layout_constraintBottom_toBottomOf="@id/ivShare"
                        app:layout_constraintEnd_toStartOf="@id/ivShare"
                        app:layout_constraintTop_toTopOf="@id/ivShare" />
                    <TextView
                        android:id="@id/tvPrice"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:paddingStart="@dimen/margin_15dp"
                        android:paddingEnd="@dimen/dimen_4dp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/dimen_16sp"
                        app:layout_constraintEnd_toStartOf="@id/tvReportAds"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTractorName"
                        tools:text="15,0000"/>
                    <!-- style="@style/OutLineButtonStyle" -->
                    <TextView
                        android:id="@+id/btnGetLoan"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/margin_40dp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/dimen_5dp"
                        android:layout_marginStart="@dimen/dimen_10dp"
                        android:layout_marginEnd="@dimen/dimen_10dp"
                        android:paddingTop="@dimen/dimen_2dp"
                        android:layout_marginBottom="@dimen/margin_5dp"
                        android:textColor="@color/red"
                        android:textAlignment="center"
                        android:outlineAmbientShadowColor="@color/red"
                        android:text="@string/get_loan"
                        android:textSize="@dimen/dimen_14sp"
                        android:maxLines="1"
                        android:background="@drawable/btn_rectangle_outline_bg_red"
                        app:layout_constraintEnd_toStartOf="@+id/btnCallNow"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvPrice"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPrice"
                        tools:visibility="visible"/>
                    <!--   style="@style/OutLineButtonStyle"  -->
                    <TextView
                        android:id="@+id/btnCallNow"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/margin_40dp"
                        android:layout_marginLeft="@dimen/dimen_10dp"
                        android:layout_marginEnd="@dimen/dimen_10dp"
                        android:layout_marginTop="@dimen/dimen_5dp"
                        android:textSize="@dimen/dimen_14sp"
                        android:layout_marginBottom="@dimen/margin_5dp"
                        android:text="@string/call_now"
                        android:maxLines="1"
                        android:paddingTop="@dimen/dimen_2dp"
                        android:textAlignment="center"
                        android:textColor="@color/red"
                        android:outlineAmbientShadowColor="@color/red"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        app:layout_constraintHorizontal_bias="0.5"
                        android:background="@drawable/btn_rectangle_outline_bg_red"
                        app:layout_constraintStart_toEndOf="@+id/btnGetLoan"
                        app:layout_constraintTop_toBottomOf="@id/tvPrice"
                        tools:visibility="visible"/>
                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/flow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:paddingStart="@dimen/margin_15dp"
                        android:paddingEnd="@dimen/dimen_4dp"
                        app:constraint_referenced_ids="tvCity,tvYear,tvDriven,tvRTONo"
                        app:flow_maxElementsWrap="2"
                        app:flow_wrapMode="aligned"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btnGetLoan"/>
                    <TextView
                        android:id="@+id/tvCity"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:padding="@dimen/margin_5dp"
                        app:drawableStartCompat="@drawable/ic_location_black_outline_18dp"
                        tools:text="Pune, Maharastra"/>
                    <TextView
                        android:id="@+id/tvYear"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/margin_5dp"
                        app:drawableStartCompat="@drawable/ic_date_range_black_18dp"
                        tools:text="Jan - 11"/>
                    <TextView
                        android:id="@+id/tvDriven"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/margin_5dp"
                        app:drawableStartCompat="@drawable/ic_watch_later_black_18dp"
                        tools:text="1000"/>
                    <TextView
                        android:id="@+id/tvRTONo"
                        style="@style/ListFieldWithDrawable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/margin_5dp"
                        app:drawableStartCompat="@drawable/ic_registration_black_18dp"
                        tools:text="test04"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/detailsBackground">
                    <TextView
                        android:id="@+id/tvOtherDetails"
                        style="@style/MainTitle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:fontFamily="@font/poppins_bold"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:text="@string/other_details"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <include
                        android:id="@+id/includeExactHp"
                        layout="@layout/used_tractor_details_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/tvOtherDetails"/>
                    <include
                        android:id="@+id/includeNOC"
                        layout="@layout/used_tractor_details_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/includeExactHp"/>
                    <include
                        android:id="@+id/includeRCDoc"
                        layout="@layout/used_tractor_details_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/includeNOC"/>
                    <include
                        android:id="@+id/includeNoOfOwner"
                        layout="@layout/used_tractor_details_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/includeRCDoc"/>
                    <include
                        android:id="@+id/includeEngineCondition"
                        layout="@layout/used_tractor_details_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/includeNoOfOwner"/>
                    <include
                        android:id="@+id/includeTyreCondition"
                        layout="@layout/used_tractor_details_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/includeEngineCondition"/>
                    <include
                        android:id="@+id/includeMonthYear"
                        layout="@layout/used_tractor_details_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/includeTyreCondition"/>
                    <include
                        android:id="@+id/includeRTONo"
                        layout="@layout/used_tractor_details_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/includeMonthYear"/>
                    <include
                        android:id="@+id/includeAboutUs"
                        layout="@layout/used_tractor_details_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dimen_10dp"
                        app:layout_constraintTop_toBottomOf="@id/includeRTONo"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <include
                android:id="@+id/includeSimilar"
                layout="@layout/home_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <kr.co.prnd.readmore.ReadMoreTextView
                android:id="@+id/tv_disclaimer"
                style="@style/LongDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:readMoreMaxLine="3"
                app:readMoreText="…Read More"
                app:readMoreColor="@color/red"
                android:layout_marginTop="@dimen/margin_15dp"
                android:lineSpacingExtra="4dp"
                android:paddingStart="@dimen/margin_10dp"
                android:paddingEnd="@dimen/margin_10dp"
                tools:text="Hsfsdfsdf s  fdss fsf sfshkjhkj hdskhfkshf kshfk shf"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="5sp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="@dimen/margin_5dp">
        <TextView
            android:id="@+id/btnSellerDetails"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_40dp"

            android:fontFamily="@font/poppins_medium"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:textColor="@color/red"
            android:textAlignment="center"
            android:outlineAmbientShadowColor="@color/red"
            android:background="@drawable/btn_rectangle_outline_bg_red"

            android:layout_margin="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:text="@string/contact_seller"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_safety_tips"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteY="5dp"
            tools:visibility="visible"/>
        <TextView
            android:id="@+id/btn_safety_tips"
            android:layout_width="0dp"
            android:fontFamily="@font/poppins_medium"
            android:layout_height="@dimen/dimen_40dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:textColor="@color/red"
            android:textAlignment="center"
            android:outlineAmbientShadowColor="@color/red"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:layout_marginBottom="@dimen/dimen_10dp"


            android:layout_margin="@dimen/margin_5dp"
            android:autoLink="web"
            android:text="@string/safety_tips"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/btnSellerDetails"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteY="5dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/llProgress"
        layout="@layout/progressbar"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>