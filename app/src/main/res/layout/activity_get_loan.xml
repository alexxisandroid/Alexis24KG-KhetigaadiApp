<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".tractor.usedTractor.GetLoanActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/dimen_16dp">
            <TextView
                android:id="@+id/tvTypeOfFinance"
                style="@style/ItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                android:fontFamily="@font/poppins_bold"
                android:textStyle="bold"
                android:text="@string/type_of_finance"
                android:textAllCaps="false"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/tvTypeOfFinance"
                app:selectionRequired="true"
                app:singleSelection="true">
                <Button
                    android:id="@+id/btnNewTractor"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/new_tractor" />
                <Button
                    android:id="@+id/btnOldTractor"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/old_tractor" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <TextView
                android:id="@+id/tvLoanAmount"
                style="@style/ItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_30dp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/loan_amount"
                android:textAllCaps="false"
                app:layout_constraintTop_toBottomOf="@id/toggleButton" />
            <RadioGroup
                android:id="@+id/rgLoanAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_4dp"
                android:orientation="horizontal"
                android:weightSum="5"
                app:layout_constraintTop_toBottomOf="@id/tvLoanAmount">
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio1To2"
                    style="@style/Widget.App.RadioButton.OutLine"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="@dimen/dimen_5dp"
                    android:layout_weight="1"
                    android:text="@string/_1_2_lac"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="12sp"
                    tools:checked="false" />
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio2To3"
                    style="@style/Widget.App.RadioButton.OutLine"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="@dimen/dimen_5dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/_2_3_lac"
                    android:textSize="12sp" />
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio3To4"
                    style="@style/Widget.App.RadioButton.OutLine"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="@dimen/dimen_5dp"
                    android:layout_weight="1"
                    android:text="@string/_3_4_lac"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="12sp" />
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio4To5"
                    style="@style/Widget.App.RadioButton.OutLine"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="@dimen/dimen_5dp"
                    android:layout_weight="1"
                    android:padding="3dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/_4_5_lac"
                    android:textSize="12sp"/>
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioAbove5"
                    style="@style/Widget.App.RadioButton.OutLine"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="@dimen/dimen_5dp"
                    android:layout_weight="1"
                    android:padding="3dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/greater_than_5_lac"
                    android:textSize="12sp"/>
            </RadioGroup>
            <ImageView
                android:id="@+id/ivFront"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/dimen_5dp"
                android:layout_marginTop="@dimen/dimen_50dp"
                android:layout_marginEnd="@dimen/dimen_10dp"
                android:background="@drawable/btn_selector"
                android:scaleType="centerInside"
                android:src="@drawable/ic_camara"
                app:layout_constraintEnd_toStartOf="@id/ivBack"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rgLoanAmount" />
            <TextView
                android:id="@+id/tvFront"
                style="@style/ListFieldWithDrawable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:layout_weight="1"
                android:ellipsize="none"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="10"
                android:paddingStart="@dimen/margin_15dp"
                android:textStyle="bold"
                android:text="@string/aadhar_front_image"
                app:layout_constraintEnd_toEndOf="@id/ivFront"
                app:layout_constraintStart_toStartOf="@id/ivFront"
                app:layout_constraintTop_toBottomOf="@id/ivFront"/>
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/dimen_20dp"
                android:layout_marginTop="@dimen/dimen_50dp"
                android:layout_marginEnd="@dimen/dimen_5dp"
                android:background="@drawable/btn_selector"
                android:scaleType="centerInside"
                android:src="@drawable/ic_camara"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/ivFront"
                app:layout_constraintTop_toBottomOf="@id/rgLoanAmount" />

            <TextView
                android:id="@+id/tvBack"
                style="@style/ListFieldWithDrawable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:layout_weight="1"
                android:ellipsize="none"
                android:maxLines="10"
                android:paddingStart="@dimen/margin_15dp"
                android:text="@string/aadhar_back_image"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintEnd_toEndOf="@id/ivBack"
                app:layout_constraintStart_toStartOf="@id/ivBack"
                app:layout_constraintTop_toBottomOf="@id/ivBack"/>

            <TextView
                android:id="@+id/btnApply"
                style="@style/ButtonStylePrimary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_40dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/red"
                android:background="@drawable/btn_rectangle_outline_bg_red"
                android:layout_marginTop="@dimen/dimen_80dp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:text="@string/apply_for_loan"
                app:layout_constraintTop_toBottomOf="@id/tvBack"/>

            <TextView
                android:id="@+id/tvNote"
                style="@style/ItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_50dp"
                android:layout_weight="1"
                android:ellipsize="none"
                android:maxLines="10"
                android:fontFamily="@font/poppins_bold"
                android:paddingStart="@dimen/margin_15dp"
                android:paddingEnd="@dimen/dimen_15dp"
                android:text="@string/for_any_enquiry_and_help"
                android:textSize="@dimen/dimen_12sp"
                app:layout_constraintEnd_toEndOf="@id/btnApply"
                app:layout_constraintStart_toStartOf="@id/btnApply"
                app:layout_constraintTop_toBottomOf="@id/btnApply" />

            <Button
                android:id="@+id/btnCallNow"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dimen_15dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:text="@string/call_now"
                android:textColor="@color/white"
                app:backgroundTint="@color/red"
                app:icon="@drawable/ic_call_black_24dp"
                app:iconTint="@color/white"
                app:layout_constraintEnd_toStartOf="@+id/btnWhatsApp"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvNote" />

            <Button
                android:id="@+id/btnWhatsApp"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/dimen_20dp"
                android:layout_marginTop="@dimen/dimen_15dp"
                android:text="@string/whatsApp"
                app:strokeColor="@color/whats_app_color"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/whats_app_color"
                app:icon="@drawable/ic_sms_black_24dp"
                app:iconTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/btnCallNow"
                app:layout_constraintTop_toBottomOf="@id/tvNote" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>