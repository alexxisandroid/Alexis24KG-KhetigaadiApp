<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardViewListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/detailsBackground"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="center_vertical"
            android:background="@color/white"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/images" />
        <ImageView
            android:id="@+id/ivTrash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8dp"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_delete_black_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/trash" />
        <TextView
            android:id="@+id/tvTractorName"
            style="@style/TractorListItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="@dimen/margin_5dp"
            android:paddingEnd="@dimen/margin_5dp"
            android:paddingStart="@dimen/dimen_0dp"
            android:textColor="@color/black"
            android:textSize="@dimen/dimen_16sp"
            app:layout_constraintEnd_toStartOf="@id/ivTrash"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivImage"
            tools:text="Same Deutz Fahr Agrolux 80 Profiline" />
        <TextView
            android:id="@+id/tvViews"
            style="@style/ViewsRounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_10dp"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="0k" />
        <TextView
            android:id="@+id/tvPrice"
            style="@style/TractorPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tvTractorName"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="start"
            android:paddingStart="@dimen/margin_15dp"
            android:paddingEnd="@dimen/dimen_0dp"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="200,00" />
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_10dp"
            android:paddingStart="@dimen/margin_15dp"
            android:paddingEnd="@dimen/dimen_0dp"
            app:constraint_referenced_ids="tvSeller,tvYear,tvDriven,tvCity"
            app:flow_maxElementsWrap="3"
            app:flow_wrapMode="aligned"
            app:layout_constraintTop_toBottomOf="@id/tvPrice"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <TextView
            android:id="@+id/tvSeller"
            style="@style/ListFieldWithDrawable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/margin_5dp"
            android:maxLines="2"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_user_black_18dp"
            tools:text="Seller Name"
            tools:visibility="visible" />
        <TextView
            android:id="@+id/tvCity"
            style="@style/ListFieldWithDrawable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/margin_10dp"
            android:paddingStart="@dimen/dimen_0dp"
            app:drawableStartCompat="@drawable/ic_location_black_outline_18dp"
            tools:text="Pune" />
        <TextView
            android:id="@+id/tvYear"
            style="@style/ListFieldWithDrawable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/margin_10dp"
            android:paddingStart="@dimen/dimen_0dp"
            app:drawableStartCompat="@drawable/ic_date_range_black_18dp"
            tools:text="Jan - 11" />
        <TextView
            android:id="@+id/tvDriven"
            style="@style/ListFieldWithDrawable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/margin_5dp"
            android:paddingEnd="@dimen/margin_10dp"
            app:drawableStartCompat="@drawable/ic_watch_later_black_18dp"
            tools:text="1000" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnSellerDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/dimen_5dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flow"
            app:layout_constraintEnd_toStartOf="@id/llBuyerLabel"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:id="@+id/tvStatusLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/poppins_medium"
                android:paddingStart="@dimen/dimen_15dp"
                android:text="@string/status"
                android:paddingEnd="@dimen/dimen_0dp"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <ProgressBar
                android:id="@+id/pbSold"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/btnSoldStatus"
                app:layout_constraintEnd_toEndOf="@+id/btnSoldStatus"
                app:layout_constraintStart_toStartOf="@id/btnSoldStatus"
                app:layout_constraintTop_toTopOf="@id/btnSoldStatus"
                tools:visibility="visible" />
            <Button
                android:id="@+id/btnSoldStatus"
                style="@style/OutLineButtonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:layout_marginEnd="15dp"
                android:padding="@dimen/dimen_2dp"
                android:text="@string/click_to_sold"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvStatusLabel"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:id="@+id/llBuyerLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/btnSellerDetails"
            app:layout_constraintStart_toEndOf="@id/btnSellerDetails">
            <TextView
                android:layout_width="0dp"
                android:layout_height="@dimen/dimen_20dp"
                android:layout_weight="0.9"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:text="@string/intrested_buyers"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/tvIntrestedBuyersCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".2"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center_horizontal"
                android:text="@string/_0"
                android:textColor="@color/black" />
            <ImageButton
                android:id="@+id/ivInterestedBuyers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_weight=".5"
                android:background="@color/detailsBackground"
                android:paddingStart="-30dp"
                android:paddingEnd="@dimen/dimen_0dp"
                android:src="@drawable/down_arrow"
                app:tint="@color/black"
                android:contentDescription="@string/intrested_buyers" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llIntrestedBuyers"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/llBuyerLabel"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>