<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/tractor"
    android:textColor="@color/chip_text_tint"
    android:textSize="12sp"
    app:chipBackgroundColor="@color/chip_back_tint"
    style="@style/CustomSuggestionChip"
    android:fontFamily="@font/poppins_semi_bold"
    app:chipMinHeight="@dimen/dimen_25dp"
    app:chipMinTouchTargetSize="@dimen/dimen_30dp"
    app:chipStrokeColor="@color/charcoal"
    tools:visibility="visible"/>
