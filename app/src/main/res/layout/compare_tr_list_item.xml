<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?materialCardViewElevatedStyle"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginStart="@dimen/dimen_4dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="@dimen/dimen_4dp"
    android:layout_marginBottom="@dimen/dimen_4dp"
    android:orientation="vertical"
    app:cardCornerRadius="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTractor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/margin_5dp"
            android:gravity="center_vertical"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toTopOf="@id/guideline"
            app:layout_constraintEnd_toStartOf="@id/cvVs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.65" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_2dp"
            android:background="#e7ebf2"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guideline" />

        <TextView
            android:id="@+id/tvTractorName"
            style="@style/TractorListItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8dp"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="0dp"
            android:textColor="@color/black"
            app:layout_constraintBottom_toTopOf="@id/tvHP"
            app:layout_constraintEnd_toEndOf="@id/ivTractor"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="@id/ivTractor"
            app:layout_constraintTop_toBottomOf="@id/ivTractor"
            tools:text="Force Motors Balwan 400 dndnfs" />

        <TextView
            android:id="@+id/tvHP"
            style="@style/ItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/ivTractor"
            app:layout_constraintStart_toStartOf="@id/ivTractor"
            tools:text="45 HP" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvVs"
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/pickledBlueWood"
            app:cardCornerRadius="@dimen/dimen_30dp"
            app:layout_constraintBottom_toBottomOf="@id/guideline"
            app:layout_constraintEnd_toStartOf="@id/ivTractor1"
            app:layout_constraintStart_toEndOf="@id/ivTractor"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvVs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_15dp"
                android:text="@string/vs"
                android:textAllCaps="true"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/ivTractor1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/margin_5dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toTopOf="@id/guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cvVs"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTractorName1"
            style="@style/TractorListItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8dp"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="0dp"
            android:textColor="@color/black"
            app:layout_constraintBottom_toTopOf="@id/tvHP1"
            app:layout_constraintEnd_toEndOf="@id/ivTractor1"
            app:layout_constraintStart_toStartOf="@id/ivTractor1"
            app:layout_constraintTop_toBottomOf="@id/ivTractor1"
            tools:text="Force Motors Balwan 400 dndnfs" />

        <TextView
            android:id="@+id/tvHP1"
            style="@style/ItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/ivTractor1"
            app:layout_constraintStart_toStartOf="@id/ivTractor1"
            tools:text="45 HP" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

