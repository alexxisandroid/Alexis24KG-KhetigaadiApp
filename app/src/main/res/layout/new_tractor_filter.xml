<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    tools:context=".tractor.newTractor.search.SearchNewTractorFilter">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pageBackGround">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="225dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <me.relex.circleindicator.CircleIndicator
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:ci_drawable="@drawable/ic_circle_red_24dp"
            app:ci_drawable_unselected="@drawable/ic_circle_black_24dp"
            app:ci_height="6dp"
            app:ci_margin="@dimen/dimen_4dp"
            app:ci_width="6dp"
            app:layout_constraintTop_toBottomOf="@id/viewPager"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvSearchByName"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/indicator">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10dp">
                <TextView
                    style="@style/SearchPageHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_tractor_by_name"
                    android:padding="@dimen/dimen_10dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black" />
                <EditText
                    android:id="@+id/edSearchTractorByName"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:focusableInTouchMode="false"
                    android:hint="@string/type_to_select_name"
                    android:longClickable="false"
                    app:layout_constraintTop_toBottomOf="@+id/searchByBrand"
                    android:autofillHints="name"
                    android:inputType="text"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/tvOrLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_40dp"
            android:layout_marginEnd="@dimen/margin_20dp"
            android:layout_weight="1"
            android:background="@color/navy_blue"
            app:layout_constraintBottom_toBottomOf="@id/tvOr"
            app:layout_constraintEnd_toStartOf="@+id/tvOr"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvOr" />
        <TextView
            android:id="@+id/tvOr"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/margin_20dp"
            android:background="@drawable/rounded_corner_btn_with_light_color"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/or"
            android:textAllCaps="true"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@+id/tvOrLine1"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvOrLine"
            app:layout_constraintTop_toBottomOf="@id/cvSearchByName" />
        <TextView
            android:id="@+id/tvOrLine1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_20dp"
            android:layout_marginEnd="@dimen/margin_40dp"
            android:background="@color/navy_blue"
            app:layout_constraintBottom_toBottomOf="@id/tvOr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvOr"
            app:layout_constraintTop_toTopOf="@id/tvOr" />
        <TextView
            android:id="@+id/tvDoYouHaveLabel"
            style="@style/homePageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:padding="5dp"
            android:text="@string/do_you_have_a_tractor_in_mind"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvOr" />
        <androidx.cardview.widget.CardView
            android:id="@+id/cvBrandModel"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/tvDoYouHaveLabel">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10dp">
                <TextView
                    android:id="@+id/searchByBrand"
                    style="@style/SearchPageHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold"
                    android:padding="@dimen/dimen_10dp"
                    android:text="@string/search_by_brand_and_model"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent" />
                <EditText
                    android:id="@+id/et_brand"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:clickable="true"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:focusable="true"
                    android:hint="@string/brand"
                    android:inputType="text"
                    android:longClickable="false"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    app:layout_constraintTop_toBottomOf="@+id/searchByBrand"
                    android:autofillHints="brand" />
                <EditText
                    android:id="@+id/et_model"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:backgroundTint="@color/grey_line"
                    android:clickable="true"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:focusable="false"
                    android:hint="@string/model"
                    android:inputType="text"
                    android:longClickable="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/et_brand"
                    android:autofillHints="model" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvSearchByHP"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@+id/cvBrandModel">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/SearchPageHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:padding="@dimen/dimen_10dp"
                    android:textColor="@color/black"/>
                <EditText
                    android:id="@+id/et_hp"
                    style="@style/SearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/select_hp"
                    android:inputType="text"
                    android:longClickable="false"
                    android:autofillHints="hp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvDrive"
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/cvSearchByHP">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
       <!-- style="@style/SearchPageHeading" -->
                <TextView
                    android:id="@+id/tvDrive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/drive"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:padding="@dimen/dimen_10dp"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"/>
                <!--    style="@style/ButtonStyleFilledPrimary"    -->
                <Button
                    android:id="@+id/btn2WD"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:text="@string/wd2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvDriveDash"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDrive"/>

                <!--   app:layout_constraintHorizontal_chainStyle="packed"  -->

                <TextView
                    android:id="@+id/tvDriveDash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash"
                    app:layout_constraintBottom_toBottomOf="@id/btn2WD"
                    app:layout_constraintEnd_toStartOf="@+id/btn4WD"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/btn2WD"
                    app:layout_constraintTop_toTopOf="@id/btn2WD"/>

           <!-- style="@style/ButtonStyleFilledPrimary" -->
                <Button
                    android:id="@+id/btn4WD"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:text="@string/wd4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvDriveDash"
                    app:layout_constraintTop_toBottomOf="@id/tvDrive"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            style="@style/CardViewListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@+id/cvDrive">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvSearchByBrand"
                    style="@style/SearchPageHeading"
                    android:layout_width="match_parent"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:padding="@dimen/dimen_10dp"
                    android:layout_height="wrap_content"
                    android:text="@string/search_by_brand"/>
                <LinearLayout
                    android:id="@+id/llBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>