<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:paddingStart="@dimen/dimen_28dp"
    android:paddingEnd="@dimen/dimen_1dp"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:orientation="vertical">
    <!-- 30,16
         android:layout_width="@dimen/payu_dimen_34dp"
         android:layout_height="@dimen/payu_dimen_34dp"  -->
    <ImageView
        android:id="@+id/iconimage"
        android:layout_width="@dimen/payu_dimen_36dp"
        android:layout_height="@dimen/payu_dimen_36dp"
        android:paddingEnd="@dimen/dimen_0dp"
        android:paddingStart="@dimen/dimen_0dp"
        android:src="@drawable/ic_home_24dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@string/images"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.14467005"/>
    <!-- style="@style/DrawerMenu" -->
    <TextView
        android:id="@+id/submenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:fontFamily="@font/poppins"
        android:paddingStart="@dimen/dimen_16dp"
        android:paddingEnd="@dimen/dimen_2dp"
        android:textSize="@dimen/dimen_16sp"
        android:text="@string/app_name"
        android:textAppearance="?android:attr/textAppearanceListItem"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/indicator"
        android:layout_width="@dimen/dimen_40dp"
        android:layout_height="@dimen/dimen_40dp"
        android:paddingEnd="@dimen/dimen_10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        app:tint="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@string/indicator_and_gauge"/>
</androidx.constraintlayout.widget.ConstraintLayout>