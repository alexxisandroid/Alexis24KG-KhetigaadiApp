<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/cxzc"
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="?actionBarSize"
        android:visibility="gone"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_margin="@dimen/dimen_10dp"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:layout_marginStart="@dimen/dimen_16dp"
                        android:textSize="@dimen/payu_dimen_28dp"
                        android:gravity="center|start"
                        android:padding="@dimen/dimen_4dp"
                        android:layout_marginTop="@dimen/dimen_20dp"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        android:text="@string/settings"
                        android:layout_height="wrap_content"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/margin_15dp"
                        android:paddingTop="@dimen/margin_10dp"
                        android:paddingEnd="@dimen/margin_15dp"
                        android:layout_marginBottom="@dimen/dimen_10dp"
                        android:paddingBottom="10dp">
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/ivImage"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/user_rounded"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/ivEditImage"
                            android:layout_width="40dp"
                            android:layout_height="45dp"
                            android:layout_gravity="center|bottom"
                            android:layout_marginBottom="15dp"
                            android:clickable="true"
                            android:focusable="true"
                             android:layout_marginStart="-5dp"
                            android:src="@drawable/ic_edit_black_48dp"
                            app:layout_constraintBottom_toBottomOf="@id/ivImage"
                            app:layout_constraintStart_toEndOf="@id/ivImage"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_1dp"
                        android:layout_margin="@dimen/dimen_20dp"
                        android:background="@color/brightGray"/>
                    <TextView
                        android:id="@+id/tvEditProfile"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:layout_marginStart="@dimen/dimen_16dp"
                        android:drawableTint="@color/blackLight"
                        android:gravity="center|start"
                        android:padding="@dimen/dimen_4dp"
                        android:layout_marginTop="@dimen/dimen_10dp"
                        android:textSize="@dimen/dimen_18sp"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        android:drawablePadding="@dimen/payu_dimen_18dp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/edit_profile"
                        android:drawableStart="@drawable/edit"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_1dp"
                        android:layout_margin="@dimen/dimen_20dp"
                        android:visibility="gone"
                        android:background="@color/brightGray"/>
                    <TextView
                        android:id="@+id/tvChangeLanguage"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:drawablePadding="@dimen/payu_dimen_18dp"
                        android:gravity="center|start"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        android:textSize="@dimen/dimen_18sp"
                        android:drawableStart="@drawable/languages_white_24"
                        android:drawableTint="@color/blackLight"
                        android:layout_marginStart="@dimen/dimen_16dp"
                        android:text="@string/change_language"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_1dp"
                        android:layout_margin="@dimen/dimen_20dp"
                        android:visibility="gone"
                        android:background="@color/brightGray"/>
                    <TextView
                        android:id="@+id/tvBlockedUsers"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:drawableStart="@drawable/ic_orders_black_outline_24dp"
                        android:gravity="center|start"
                        android:layout_marginStart="@dimen/dimen_16dp"
                        android:fontFamily="@font/manrope_bold"
                        android:drawablePadding="@dimen/payu_dimen_18dp"
                        android:drawableTint="@color/blackLight"
                        android:textSize="@dimen/dimen_18sp"
                        android:visibility="gone"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        android:text="@string/blocked_users"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_1dp"
                        android:layout_margin="@dimen/dimen_20dp"
                        android:visibility="gone"
                        android:background="@color/brightGray"/>
                    <TextView
                        android:id="@+id/tvLogout"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:gravity="center|start"
                        android:drawablePadding="@dimen/payu_dimen_18dp"
                        android:visibility="gone"
                        android:fontFamily="@font/manrope_bold"
                        app:drawableStartCompat="@drawable/logout_white"
                        app:drawableTint="@color/blackLight"
                        android:textSize="@dimen/dimen_18sp"
                        android:layout_marginStart="@dimen/dimen_16dp"
                        android:text="@string/logout"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <TextView
                        android:id="@+id/tvDeleteAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dimen_40dp"

                        android:drawablePadding="@dimen/payu_dimen_18dp"
                        android:gravity="center_vertical"
                        android:text="@string/delete_account"
                        android:visibility="visible"
                        android:textSize="@dimen/dimen_18sp"
                        android:fontFamily="@font/manrope_bold"
                        android:textColor="@color/red"
                        android:layout_marginStart="@dimen/dimen_16sp"
                        android:textStyle="bold"
                        app:drawableTint="@color/black"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        app:drawableStartCompat="@drawable/trash"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCommentsByMe" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_1dp"
                        android:layout_margin="@dimen/dimen_20dp"
                        android:background="@color/brightGray"/>
                    <TextView
                        android:id="@+id/tvAboutUs"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:gravity="center|start"
                        android:drawablePadding="@dimen/dimen_10dp"
                        android:alpha="0.8"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginStart="@dimen/dimen_20dp"
                        android:text="@string/about_us"
                        android:layout_marginTop="@dimen/dimen_10dp"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <TextView
                        android:id="@+id/tvContactus"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:gravity="center|start"
                        android:drawablePadding="@dimen/dimen_10dp"
                        android:alpha="0.8"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginStart="@dimen/dimen_20dp"
                        android:text="@string/contact_us"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <TextView
                        android:id="@+id/tvPrivacypolicy"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:gravity="center|start"
                        android:drawablePadding="@dimen/dimen_10dp"
                        android:alpha="0.8"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginStart="@dimen/dimen_20dp"
                        android:text="@string/privacy_policy"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <TextView
                        android:id="@+id/tvReturnpolicy"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:gravity="center|start"
                        android:drawablePadding="@dimen/dimen_10dp"
                        android:alpha="0.8"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginStart="@dimen/dimen_20dp"
                        android:text="@string/return_policy"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <TextView
                        android:id="@+id/tvChatWithExpert"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:gravity="center|start"
                        android:drawablePadding="@dimen/dimen_10dp"
                        android:visibility="gone"
                        android:alpha="0.8"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginStart="@dimen/dimen_20dp"
                        android:text="@string/chat_with_expert"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <TextView
                        android:id="@+id/tvMyAddress"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:gravity="center|start"
                        android:drawablePadding="@dimen/dimen_10dp"
                        android:alpha="0.8"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginStart="@dimen/dimen_20dp"
                        android:text="@string/my_address"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <TextView
                        android:id="@+id/tvMyorders"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:gravity="center|start"
                        android:drawablePadding="@dimen/dimen_10dp"
                        android:alpha="0.8"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginStart="@dimen/dimen_20dp"
                        android:text="@string/my_orders"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <TextView
                        android:id="@+id/tvAppVerision"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center|start"
                        android:gravity="center|start"
                        android:drawablePadding="@dimen/dimen_10dp"
                        android:alpha="0.8"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginStart="@dimen/dimen_20dp"
                        android:text="@string/version"
                        android:layout_height="@dimen/dimen_40dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="@dimen/dimen_20dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone"
                        android:layout_height="@dimen/dimen_50dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone"
                        android:layout_height="@dimen/dimen_50dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone"
                        android:layout_height="@dimen/dimen_50dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone"
                        android:layout_height="@dimen/dimen_50dp"/>
                    <LinearLayout
                        android:id="@+id/ll_smedd"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_50dp"
                        app:layout_constraintTop_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:background="@color/trans"
                        android:gravity="center"
                        android:paddingStart="@dimen/dimen_5dp"
                        android:paddingEnd="@dimen/dimen_16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/iv_facebook"
                            android:layout_width="@dimen/payu_dimen_34dp"
                            android:layout_height="@dimen/payu_dimen_34dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_weight="1"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:padding="@dimen/dimen_5dp"
                            android:src="@drawable/ic_facebookk"
                            app:layout_constraintEnd_toStartOf="@+id/iv_instagram"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/iv_instagram"
                            android:layout_width="@dimen/payu_dimen_34dp"
                            android:layout_height="@dimen/payu_dimen_34dp"
                            android:contentDescription="@null"
                            android:padding="@dimen/dimen_5dp"
                            android:layout_weight="1"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_instagram"
                            app:layout_constraintEnd_toStartOf="@+id/iv_linked_in"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/iv_facebook"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/iv_linked_in"
                            android:layout_width="@dimen/payu_dimen_34dp"
                            android:layout_height="@dimen/payu_dimen_34dp"
                            android:contentDescription="@null"
                            android:padding="@dimen/dimen_5dp"
                            android:layout_weight="1"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_linkedln"
                            app:layout_constraintEnd_toStartOf="@+id/ivWhatsApp"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/iv_instagram"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/ivWhatsApp"
                            android:layout_width="@dimen/payu_dimen_34dp"
                            android:layout_height="@dimen/payu_dimen_34dp"
                            android:contentDescription="@null"
                            android:layout_gravity="center"
                            android:padding="@dimen/dimen_5dp"
                            android:layout_weight="1"
                            android:src="@drawable/ic_whats_app"
                            app:layout_constraintEnd_toStartOf="@+id/iv_youtude"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/iv_linked_in"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/iv_youtude"
                            android:layout_width="@dimen/payu_dimen_34dp"
                            android:layout_height="@dimen/payu_dimen_34dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_you_tube"
                            android:layout_gravity="center"
                            android:padding="@dimen/dimen_5dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_weight="1"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/ivWhatsApp"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvShare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="false"
                            android:drawablePadding="@dimen/dimen_5dp"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:paddingTop="@dimen/dimen_2dp"
                            android:text="@string/share"
                            android:textColor="@color/navy_blue"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toStartOf="@+id/vLine"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:drawableTopCompat="@drawable/ic_share_24dp"/>
                        <TextView
                            android:id="@+id/vLine"
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="7dp"
                            android:layout_marginBottom="7dp"
                            android:background="@color/navy_blue"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/llRate"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/tvShare"/>
                        <TextView
                            android:id="@+id/tvRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="false"
                            android:drawablePadding="@dimen/dimen_5dp"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:paddingTop="@dimen/dimen_2dp"
                            android:text="@string/rate"
                            android:textColor="@color/navy_blue"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:drawableTopCompat="@drawable/ic_rating_24dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/vLine1"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/vLine"/>
                        <TextView
                            android:id="@+id/vLine1"
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="7dp"
                            android:layout_marginBottom="7dp"
                            android:background="@color/navy_blue"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tvFeedback"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/llRate"/>
                        <!-- android:fontFamily="@font/poppins_medium" -->
                        <TextView
                            android:id="@+id/tvFeedback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="@dimen/dimen_5dp"
                            android:gravity="center"
                            android:paddingTop="2dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/feedback"
                            android:textColor="@color/navy_blue"
                            android:textSize="11sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/vLine1"
                            app:drawableTopCompat="@drawable/ic_feedback_24dp"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <!--   -->
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>