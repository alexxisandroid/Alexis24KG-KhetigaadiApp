<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    style="?attr/materialCardViewElevatedStyle"
    android:layout_marginStart="@dimen/dimen_4dp"
    android:layout_marginTop="@dimen/dimen_2dp"
    android:layout_marginEnd="@dimen/dimen_4dp"
    app:strokeColor="@color/brightGray"
    app:strokeWidth="@dimen/dimen_1dp"
    android:elevation="@dimen/margin_2dp"
    app:cardElevation="@dimen/margin_2dp"
    android:background="@drawable/spinner_border"
    android:backgroundTint="@color/black"
    android:layout_marginBottom="@dimen/dimen_4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <!--
    android:layout_marginStart="@dimen/dimen_4dp"
    android:layout_marginTop="@dimen/dimen_2dp"
    android:layout_marginEnd="@dimen/dimen_4dp"
    android:layout_marginBottom="@dimen/dimen_4dp" -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/payu_dimen_220dp"
        android:minHeight="@dimen/dimen_220dp"
        android:background="@color/white">
        <ImageView
            android:id="@+id/popularTractorImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:background="@color/detailsBackground"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:padding="@dimen/margin_2dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toTopOf="@id/popularTractorTitle"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/popular_tractor"/>
  <!--    style="@style/ViewsRoundedSmall"  -->
        <TextView
            android:id="@+id/tvViews"
            style="@style/ViewsRoundedSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_gravity="center_vertical|start|center"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:gravity="start|center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="0k" />
        <!--  style = "@style/TractorListItemTitle"   android:fontFamily="@font/poppins_semi_bold" -->
        <TextView
            android:id="@+id/popularTractorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             style = "@style/TractorListItemTitle"
            android:fontFamily="@font/manrope_bold"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/charcoal"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:layout_marginTop="@dimen/dimen_4dp"
            android:layout_marginEnd="@dimen/dimen_4dp"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/tvHP"
            tools:text=" Sonalika DI 47 Rx (MahSnecial)"/>
        <!--  style="@style/ItemTitle"  android:fontFamily="@font/poppins"  -->
        <TextView
            android:id="@+id/tvHP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/payu_dimen_12dp"
            style="@style/ItemTitle"
            android:layout_marginBottom="@dimen/dimen_5dp"
            android:fontFamily="@font/manrope_regular"
            android:textColor="@color/charcoal"
            android:textSize="@dimen/dimen_12sp"
            app:layout_constraintBottom_toTopOf="@id/btnGetOnRoadPrice"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="45 HP"/>
        <!--   style="@style/ItemTitle"  -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ItemTitle"
            android:layout_marginEnd="@dimen/margin_15dp"
            android:layout_marginBottom="5dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btnGetOnRoadPrice"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="6-7 Lakh"
            tools:visibility="visible"/>
<!--com.google.android.material.button.MaterialButton  style = "@style/OutLineButtonStyleSmall"
      android:fontFamily="@font/poppins_medium" -->
        <TextView
            android:id="@+id/btnGetOnRoadPrice"
            android:layout_width="match_parent"

            android:fontFamily="@font/manrope_medium"
            android:layout_height="@dimen/payu_dimen_38dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:textColor="@color/red"
            android:textAlignment="center"
            android:outlineAmbientShadowColor="@color/red"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:text="@string/getOnRoadPrice"
            android:textSize="@dimen/dimen_12sp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>