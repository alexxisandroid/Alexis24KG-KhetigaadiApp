<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    style="?attr/materialCardViewElevatedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dimen_4dp"
    android:layout_marginTop="@dimen/dimen_2dp"
    android:layout_marginEnd="@dimen/dimen_4dp"
    android:layout_marginBottom="@dimen/dimen_4dp"
    app:cardCornerRadius="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="214dp"
        android:background="@color/munsell">
        <ImageView
            android:id="@+id/popularTractorImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:background="@color/white"
            android:padding="@dimen/margin_5dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toTopOf="@id/popularTractorTitle"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/popular_tractor"/>
  <!--    style="@style/ViewsRoundedSmall"  -->
        <TextView
            android:id="@+id/tvViews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            style="@style/ViewsRoundedSmall"
            android:layout_gravity="center_vertical|center_horizontal"
            android:layout_marginStart="@dimen/margin_5dp"
            android:layout_marginTop="@dimen/margin_5dp"
            android:textAlignment="center"
            android:paddingBottom="@dimen/dimen_2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="0k"/>
        <!--  style = "@style/TractorListItemTitle"   android:fontFamily="@font/poppins_semi_bold" -->
        <TextView
            android:id="@+id/popularTractorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             style = "@style/TractorListItemTitle"
            android:fontFamily="@font/poppins_semi_bold"
            android:maxLines="1"
            android:textColor="@color/charcoal"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/tvHP"
            tools:text=" Sonalika DI 47 Rx (MahSnecial)"/>
        <!--  style="@style/ItemTitle"  android:fontFamily="@font/poppins"  -->
        <TextView
            android:id="@+id/tvHP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            style="@style/ItemTitle"
            android:fontFamily="@font/poppins"
            android:textColor="@color/charcoal"
            android:textSize="@dimen/dimen_12sp"
            app:layout_constraintBottom_toTopOf="@id/btnGetOnRoadPrice"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="45 HP"/>
        <!--   style="@style/ItemTitle"  -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ItemTitle"
            android:layout_marginEnd="@dimen/margin_15dp"
            android:layout_marginBottom="5dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btnGetOnRoadPrice"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="6-7 Lakh"
            tools:visibility="visible"/>
<!--com.google.android.material.button.MaterialButton  style = "@style/OutLineButtonStyleSmall"
      android:fontFamily="@font/poppins_medium" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetOnRoadPrice"
            android:layout_width="match_parent"
            style = "@style/OutLineButtonStyleSmall"
            android:fontFamily="@font/poppins_medium"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:text="@string/getOnRoadPrice"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>