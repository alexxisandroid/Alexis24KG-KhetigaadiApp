<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="10dp"
    android:weightSum="1">
    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="60dip"
        android:layout_height="60dip"
        android:layout_gravity="center"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/ic_location_black_outline_24dp"
        android:contentDescription="@string/image_hint"/>
    <TextView
        android:id="@+id/popup_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dip"
        android:layout_marginRight="10dip"
        android:gravity="center"
        android:text="@string/please_tell_us_your_city"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="@color/black"
        android:textSize="18sp"/>
    <TextView
        android:id="@+id/popup_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dip"
        android:text="@string/knowing_your_city_helps_us_provide"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/black"
        android:textSize="11sp"/>
    <AutoCompleteTextView
        android:id="@+id/tvCity"
        android:layout_width="match_parent"
        android:layout_height="40dip"
        android:layout_margin="6dip"
        android:minHeight="@dimen/payu_dimen_54dp"
        android:background="@drawable/edit_text_style"
        android:drawableEnd="@drawable/ic_location_black_outline_24dp"
        android:imeOptions="actionNext"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:paddingStart="5dp"
        android:paddingEnd="@dimen/dimen_5dp"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/black"
        android:textSize="14sp"
        tools:ignore="LabelFor"/>
    <Button
        android:id="@+id/btnConfirm"
        style="@style/ButtonStyleFilledRed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="6dip"
        android:layout_weight="1"
        android:text="@string/confirm_city"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="14sp"/>
</LinearLayout>