<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    style="@style/CardViewHorizontalListItem"
    app:cardCornerRadius="@dimen/margin_10dp"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:backgroundTint="@color/white"
    app:cardUseCompatPadding="true"
    android:layout_height="230dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">
        <ImageView
            android:id="@+id/popularTractorImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:background="@color/detailsBackground"
            android:padding="@dimen/margin_5dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toTopOf="@id/popularTractorTitle"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tvViews"
            style="@style/ViewsRoundedSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:gravity="start|center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="0k"/>
        <TextView
            android:id="@+id/popularTractorTitle"
            style="@style/TractorListItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/dimen_2dp"
            android:maxLines="1"
            android:textColor="@color/black"
            android:layout_marginStart="@dimen/dimen_1dp"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/tvHP"
            tools:text=" Sonalika DI 47 Rx (MahSnecial)"/>

        <TextView
            android:id="@+id/tvHP"
            style="@style/ItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginEnd="@dimen/dimen_4dp"
            android:drawablePadding="@dimen/dimen_3dp"
            app:layout_constraintBottom_toTopOf="@id/btnGetPrice"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="45 HP"/>
        <TextView
            android:id="@+id/tvType"
            style="@style/ItemTitle"
            android:layout_width="wrap_content"
            android:drawablePadding="@dimen/dimen_3dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_15dp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="5dp"
            android:visibility="visible"
            android:maxLength="15"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@+id/tvHP"
            app:layout_constraintBottom_toTopOf="@id/btnGetPrice"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="6-7 Lakh"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/btnGetPrice"
            android:layout_width="match_parent"
            android:fontFamily="@font/poppins_medium"
            android:layout_height="@dimen/payu_dimen_38dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:textColor="@color/red"
            android:textAlignment="center"
            android:outlineAmbientShadowColor="@color/red"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:textSize="@dimen/dimen_14sp"
            android:text="@string/getPrice"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>