
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/payu_dimen_90dp"
    android:layout_height="@dimen/payu_dimen_110dp"
    android:gravity="center_horizontal"
    android:layout_marginStart="@dimen/dimen_4dp"
    android:layout_marginEnd="@dimen/dimen_4dp"
    android:layout_marginTop="@dimen/dimen_5dp"
    android:layout_marginBottom="@dimen/dimen_5dp"
    android:orientation="vertical">
    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.62"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher"
        tools:background="@color/red"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:visibility="gone"
        android:background="@color/cborder"
        android:backgroundTint="@color/cborder"/>
    <TextView
        android:id="@+id/title"
        style="@style/PageMenuCat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.38"
        android:layout_gravity="center"
        android:fontFamily="@font/manrope_semibold"
        android:gravity="center"
        android:foregroundGravity="center"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/dimen_4dp"
        android:textSize="@dimen/dimen_14sp"
        tools:text=" Sonalika DI "/>
</LinearLayout>

