<?xml version="1.0" encoding="utf-8"?> <!--  style="@style/CardViewListItem"   -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?materialCardViewElevatedStyle"
    android:id="@+id/ccvvv"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/payu_dimen_12dp"
    android:layout_marginEnd="@dimen/payu_dimen_12dp"
    app:strokeWidth="@dimen/dimen_1dp"
    app:strokeColor="@color/brightGray"
    android:elevation="@dimen/margin_2dp"
    app:cardElevation="@dimen/margin_2dp"
    android:layout_marginBottom="@dimen/margin_10dp"
    android:background="@color/white"
    app:cardCornerRadius="@dimen/dimen_0dp"
    android:backgroundTint="@color/white"
    android:orientation="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/ivVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:scaleType="fitXY"
            app:layout_constraintDimensionRatio="16:9"
            android:adjustViewBounds="true"
            android:background="@color/detailsBackground"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_5dp"
            android:text="@string/compareImplement"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginEnd="@dimen/dimen_10dp"
            android:maxLines="2"
            style="@style/TractorListItemTitle"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:fontFamily="@font/manrope_semibold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivVideo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

