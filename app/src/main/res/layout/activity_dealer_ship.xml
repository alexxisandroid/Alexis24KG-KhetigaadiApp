<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    tools:context=".tractor.dealer.DealerShipActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <include layout="@layout/progressbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ri_submit"
        android:layout_below="@+id/app_bar_layout"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="@dimen/activity_horizontal_margin">


                <RelativeLayout
                    android:id="@+id/til_trimpl"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/payu_dimen_54dp"
                    android:layout_weight=".28"
                    android:background="@drawable/spinner_border"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="@dimen/dimen_10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
            <Spinner
                android:id="@+id/sp_type_tr_or_imp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:entries="@array/brand_type"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"

                app:errorTextAppearance="@style/error_appearance"
                app:layout_constraintTop_toTopOf="parent"

                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:layout_marginLeft="5dp"
                android:spinnerMode="dropdown"
                />
<!--            app:errorTextAppearance="@style/error_appearance"-->
                    <ImageView
                        android:layout_width="@dimen/payu_dimen_67dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:src="@drawable/bgg"/>
                </RelativeLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_brand"
                style="@style/FormTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/brand"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/dimen_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_trimpl">
<!--                style="@style/FormEditText"-->
                <EditText
                    android:id="@+id/et_brand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    style="@style/FormEditText"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:inputType="text"
                    android:longClickable="false"
                    android:autofillHints=""
                    tools:ignore="LabelFor"/>
            </com.google.android.material.textfield.TextInputLayout>
            <!--                style="@style/AgreementStyle"-->
            <CheckBox
                android:id="@+id/cb_agree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AgreementStyle"
                android:layout_marginTop="@dimen/dimen_16dp"
                android:text="@string/i_agree_that_by_clicking"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_brand"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.andexert.library.RippleView
        android:id="@+id/ri_submit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_60dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/dimen_10dp">
        <TextView
            style="@style/ButtonStyleFilledRed"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_50dp"
            android:textAlignment="center"
            android:text="@string/btn_submit"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_medium"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="@dimen/dimen_5dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:textColor="@color/red"
            android:outlineAmbientShadowColor="@color/red"
            android:background="@drawable/btn_rectangle_outline_bg_red"
/>
    </com.andexert.library.RippleView>
</RelativeLayout>
