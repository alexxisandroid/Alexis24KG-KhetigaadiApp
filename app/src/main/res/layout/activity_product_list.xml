<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".news.activity.NewsCommentReplyListActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/ecom_toolbar_other"/>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        android:id="@+id/rlData"
        android:layout_width="match_parent"
        android:background="@drawable/rounded_corner22"
        android:backgroundTint="@color/rv_back_color"
        android:layout_marginTop="-5dp"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <include
            android:id="@+id/llProgresss"
            layout="@layout/progressbar"/>
        <TextView
            android:id="@+id/tvvvv"
            android:layout_width="match_parent"
            android:layout_centerInParent="true"
            android:visibility="gone"
            android:layout_height="match_parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProductList"
            android:layout_width="match_parent"
            android:paddingBottom="@dimen/dimen_10dp"
            android:layout_marginEnd="@dimen/dimen_4dp"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:paddingTop="@dimen/dimen_4dp"
            android:layout_height="match_parent"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/my_sticky_button"
            style="@style/ShimmerStyle"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:backgroundTint="@color/gray_light"
            android:layout_height="match_parent"
            android:layout_gravity="bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:backgroundTint="@color/white"
                android:orientation="horizontal"
                android:padding="@dimen/margin_8dp">

                <Button
                    android:id="@+id/btnAddToCart"
                    android:layout_width="0dp"
                    style="@style/ButtonStyleFilledRed"
                    android:backgroundTint="@color/gray_light"
                    android:layout_height="match_parent"
                    android:layout_weight=".5" />

                <Button
                    android:id="@+id/btnExpertAdvice"
                    android:layout_width="0dp"
                    style="@style/ButtonStyleFilledRed"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/gray_light"
                    android:layout_marginStart="@dimen/margin_2dp"
                    android:layout_weight=".5"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <include
            android:id="@+id/inInputComment"
            layout="@layout/comment_input"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_filter"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:tint="@color/red"
            android:layout_marginBottom="@dimen/dimen_80dp"
            android:layout_marginEnd="@dimen/dimen_4dp"
            app:backgroundTint="@color/white"
            app:layout_anchorGravity="bottom|start"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>