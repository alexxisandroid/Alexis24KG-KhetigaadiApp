<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".isOwner.IsOwnerTractorImages">
    <include
        android:id="@+id/toolbarI"
        layout="@layout/toolbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/nav_tab"
            layout="@layout/is_owner_nav_tab"/>
        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/nav_tab"
            android:background="@color/grey_line"/>
        <TextView
            android:id="@+id/tv_camera_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/view"
            android:layout_margin="5dp"
            android:gravity="center"
            android:maxLines="2"
            android:padding="10dp"
            android:text="@string/image_hint"
            android:textColor="@color/black"
            android:textStyle="bold"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/cv_camera_btn"
            android:layout_below="@+id/tv_camera_hint">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:orientation="vertical">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight=".50"
                        android:padding="5dp"
                        app:cardCornerRadius="8dp">
                        <ImageView
                            android:id="@+id/iv_first"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/btn_selector"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_camara"
                            android:contentDescription="@string/first" />
                    </androidx.cardview.widget.CardView>
                    <!-- COLUMN 2  -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight=".50"
                        android:padding="5dp"
                        app:cardCornerRadius="8dp">
                        <ImageView
                            android:id="@+id/iv_second"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/btn_selector"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_camara"
                            android:contentDescription="@string/second" />
                    </androidx.cardview.widget.CardView>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_camera_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="center">
            <TextView
                android:id="@+id/btn_is_owner_submit"
                style="@style/ButtonStyleFilledRed"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_50dp"
                android:layout_gravity="center"
                android:layout_margin="@dimen/dimen_5dp"

                android:textColor="@color/red"
                android:textAlignment="center"
                android:outlineAmbientShadowColor="@color/red"
                android:background="@drawable/btn_rectangle_outline_bg_red"
                android:layout_marginBottom="@dimen/dimen_10dp"

                android:gravity="center"
                android:text="@string/continue_string"
                android:textAllCaps="false"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</androidx.appcompat.widget.LinearLayoutCompat>