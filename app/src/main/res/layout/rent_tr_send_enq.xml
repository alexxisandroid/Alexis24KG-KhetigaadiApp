<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/riSendEnquiry"
        android:layout_below="@+id/toolbar"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingTop="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_msg"
                style="@style/FormTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_yourMsg"
                app:errorTextAppearance="@style/error_appearance"
                app:layout_constraintTop_toTopOf="parent">
                <EditText
                    android:id="@+id/input_msg"
                    style="@style/FormEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="255"
                    android:autofillHints="msg"
                    tools:ignore="LabelFor"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_email"
                style="@style/FormTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email"
                app:errorTextAppearance="@style/error_appearance"
                app:layout_constraintTop_toBottomOf="@id/input_layout_msg">
                <EditText
                    android:id="@+id/input_email"
                    style="@style/FormEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:focusable="false"
                    android:imeOptions="actionNext"
                    android:lines="1"
                    android:inputType="textEmailAddress"
                    android:longClickable="false"
                    android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_mobile"
                style="@style/FormTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_mobile"
                app:errorTextAppearance="@style/error_appearance"
                app:layout_constraintTop_toBottomOf="@id/input_layout_email">
                <EditText
                    android:id="@+id/input_mobile"
                    style="@style/FormEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/payu_dimen_54dp"
                    android:clickable="false"
                    android:imeOptions="actionDone"
                    android:focusable="false"
                    android:inputType="phone"
                    android:longClickable="false"
                    android:maxLength="15"
                    android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/input_layout_mobile" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.andexert.library.RippleView
        android:id="@+id/riSendEnquiry"
        android:layout_width="match_parent"
        android:layout_height="@dimen/payu_dimen_45dp"
        android:layout_gravity="bottom"
        android:background="@drawable/btn_rectangle_outline_bg_red"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/margin_10dp"
        android:layout_marginBottom="@dimen/dimen_10dp"
        android:textColor="@color/red"
        android:textAlignment="center"
        android:outlineAmbientShadowColor="@color/red">
<!--        <Button-->
<!--            style="@style/ButtonStyleFilledRed"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="match_parent"-->
<!--            android:textAlignment="center"-->
<!--            android:text="@string/send_enquiry"/>-->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/send_enquiry"
            android:textAlignment="center"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:minHeight="@dimen/payu_dimen_45dp"
            android:textAllCaps="false"
            android:textColor="@color/red"/>
    </com.andexert.library.RippleView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>