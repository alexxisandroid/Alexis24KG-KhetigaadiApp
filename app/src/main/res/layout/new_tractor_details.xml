<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            style="@style/MyTabLayoutStyleLarge"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#F8F8F8"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/light_red"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/light_red"
            app:tabTextColor="@color/blackLight"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dimen_50dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="5sp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="@dimen/margin_5dp">
        <TextView
            android:id="@+id/btnOnRoadPrice"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_40dp"
            android:layout_margin="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:text="@string/getOnRoadPrice"
            android:minHeight="@dimen/payu_dimen_45dp"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:textAlignment="center"
            android:textColor="@color/red"
            android:gravity="center"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnRequestForDemo"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible"/>
        <TextView
            android:id="@+id/btnRequestForDemo"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_40dp"
            android:layout_margin="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:autoLink="web"
            android:minHeight="@dimen/payu_dimen_45dp"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:textAlignment="center"
            android:textColor="@color/red"
            android:gravity="center"
            android:text="@string/request_for_demo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/btnOnRoadPrice"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
