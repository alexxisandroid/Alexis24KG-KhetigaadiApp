<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    style="?materialCardViewElevatedStyle"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    app:strokeColor="@color/brightGray"
    app:strokeWidth="@dimen/dimen_1dp"
    android:elevation="@dimen/margin_2dp"
    app:cardElevation="@dimen/margin_2dp"
    app:cardCornerRadius="@dimen/dimen_0dp"
    android:backgroundTint="@color/white"
    android:background="@color/white"
    android:layout_margin="@dimen/dimen_4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingStart="50dp"
            android:paddingTop="@dimen/margin_40dp"
            android:paddingBottom="@dimen/margin_40dp"
            android:paddingEnd="@dimen/dimen_50dp"
            android:layout_weight="0.8"
            android:padding="8dp"
            android:src="@mipmap/ic_launcher"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/dimen_5dp"
            android:layout_weight="0.2"
            android:fontFamily="@font/manrope_semibold"
            android:layout_gravity="center"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center"

            android:textColor="@color/charcoal"
            android:textSize="@dimen/dimen_16sp"
            tools:text=" Sonalika DI 47 Rx (MahSnecial)"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>