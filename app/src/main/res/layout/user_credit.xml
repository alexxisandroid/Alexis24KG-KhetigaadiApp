<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:showIn="@layout/activity_profile">
    <TextView
        android:id="@+id/tvFollowers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_5dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:padding="@dimen/margin_5dp"
        android:text="@string/_0_"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tvFollowing"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:drawableTopCompat="@drawable/ic_followers"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/followers"
        android:textAlignment="center"
        android:textSize="@dimen/dimen_10dp"
        android:fontFamily="@font/manrope_medium"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        app:layout_constraintEnd_toEndOf="@id/tvFollowers"
        app:layout_constraintStart_toStartOf="@id/tvFollowers"
        app:layout_constraintTop_toBottomOf="@id/tvFollowers"/>
    <TextView
        android:id="@+id/tvFollowing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_5dp"
        android:gravity="center"
        android:padding="@dimen/margin_5dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/_0_"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tvLikes"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvFollowers"
        app:layout_constraintTop_toTopOf="parent"
        app:drawableTopCompat="@drawable/ic_following"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/following"
        android:textAlignment="center"
        android:fontFamily="@font/manrope_medium"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textSize="@dimen/dimen_10dp"
        app:layout_constraintEnd_toEndOf="@id/tvFollowing"
        app:layout_constraintStart_toStartOf="@id/tvFollowing"
        app:layout_constraintTop_toBottomOf="@id/tvFollowing"/>
    <TextView
        android:id="@+id/tvLikes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_5dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:padding="@dimen/margin_5dp"
        android:text="@string/_0_"
        android:textColor="@color/black"
        android:visibility="gone"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tvPosts"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvFollowing"
        app:layout_constraintTop_toTopOf="parent"
        app:drawableTopCompat="@drawable/ic_like"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/likes"
        android:textAlignment="center"
        android:fontFamily="@font/manrope_medium"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textSize="@dimen/dimen_10dp"
        app:layout_constraintEnd_toEndOf="@id/tvLikes"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tvLikes"
        app:layout_constraintTop_toBottomOf="@id/tvLikes"/>
    <TextView
        android:id="@+id/tvPosts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_5dp"
        android:gravity="center"
        android:padding="@dimen/margin_5dp"
        android:text="@string/_0_"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tvComments"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvLikes"
        app:layout_constraintTop_toTopOf="parent"
        app:drawableTopCompat="@drawable/ic_post"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/posts"
        android:textAlignment="center"
        android:fontFamily="@font/manrope_medium"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textSize="@dimen/dimen_10sp"
        app:layout_constraintEnd_toEndOf="@id/tvPosts"
        app:layout_constraintStart_toStartOf="@id/tvPosts"
        app:layout_constraintTop_toBottomOf="@id/tvPosts"/>
    <TextView
        android:id="@+id/tvComments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_5dp"
        android:gravity="center"
        android:padding="@dimen/margin_5dp"
        android:text="@string/_0_"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins_semibold"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tvShares"
        app:layout_constraintHorizontal_bias="0.5"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/tvPosts"
        app:layout_constraintTop_toTopOf="parent"
        app:drawableTopCompat="@drawable/ic_comment"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/comments"
        android:textAlignment="center"
        android:visibility="gone"
        android:fontFamily="@font/manrope_medium"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textSize="@dimen/dimen_10sp"
        app:layout_constraintEnd_toEndOf="@id/tvComments"
        app:layout_constraintStart_toStartOf="@id/tvComments"
        app:layout_constraintTop_toBottomOf="@id/tvComments"/>
    <TextView
        android:id="@+id/tvShares"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_5dp"
        android:gravity="center"
        android:padding="@dimen/margin_5dp"
        android:text="@string/_0_"
        android:visibility="gone"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins_semibold"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvComments"
        app:layout_constraintTop_toTopOf="parent"
        app:drawableTopCompat="@drawable/ic_share"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/shares"
        android:visibility="gone"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textSize="@dimen/dimen_10sp"
        android:fontFamily="@font/manrope_medium"
        app:layout_constraintEnd_toEndOf="@id/tvShares"
        app:layout_constraintStart_toStartOf="@id/tvShares"
        app:layout_constraintTop_toBottomOf="@id/tvShares"/>
</androidx.constraintlayout.widget.ConstraintLayout>