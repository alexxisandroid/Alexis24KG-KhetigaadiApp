<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="100dp"
    android:paddingStart="@dimen/dimen_10dp"
    android:paddingTop="@dimen/dimen_4dp"
    android:padding="@dimen/payu_dimen_12dp"
    android:paddingEnd="@dimen/dimen_10dp"
    android:background="@drawable/side_nav_bar"
    android:backgroundTint="@color/white">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/civUserImage"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center|center_horizontal"
        android:src="@drawable/user_rounded"
        app:finalHeight="@dimen/image_final_width"
        app:finalToolbarHeight="?attr/actionBarSize"
        app:finalXPosition="@dimen/spacing_small"
        android:layout_marginTop="@dimen/payu_dimen_24dp"
        app:finalYPosition="@dimen/spacing_small"
        app:layout_anchorGravity="bottom|start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
 <!--   style="@style/CardViewListItem"   -->
    <TextView
        android:id="@+id/tvUserType"
        android:layout_width="wrap_content"
        style="@style/CardViewListItem"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-14dp"
        android:background="@drawable/user_type_background"
        android:paddingStart="@dimen/margin_10dp"
        android:paddingEnd="@dimen/margin_10dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@id/civUserImage"
        app:layout_constraintEnd_toEndOf="@id/civUserImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/civUserImage"
        tools:text="farmer"/>
<!--  style="@style/TractorListItemTitle" app:layout_constraintBottom_toBottomOf="@id/civUserImage"  -->
    <TextView
        android:id="@+id/tvUserName"
        style="@style/TractorListItemTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/payu_dimen_6dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:text="@string/app_name"
        android:textSize="@dimen/dimen_16sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/civUserImage"
        app:layout_constraintTop_toTopOf="@+id/civUserImage"/>
    <!--  style="@style/TractorListItemTitle"   -->
    <TextView
        android:id="@+id/tvAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:gravity="start"
        style="@style/TractorListItemTitle"
        android:textSize="@dimen/dimen_10sp"
        android:layout_marginStart="@dimen/dimen_2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/civUserImage"
        app:layout_constraintTop_toBottomOf="@id/tvUserName"
        tools:text="Pune, Maharashtra"/>
    <!--   style="@style/TractorListItemTitle" -->
    <TextView
        android:id="@+id/tvUpdateProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/updateYourProfile"
        android:textColor="@color/red"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:layout_marginBottom="@dimen/dimen_1dp"
        android:paddingTop="@dimen/dimen_1dp"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvAddress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/civUserImage"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"
        android:layout_marginTop="@dimen/dimen_20dp"
        app:layout_constraintTop_toBottomOf="@id/tvUpdateProfile"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/grey_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>

