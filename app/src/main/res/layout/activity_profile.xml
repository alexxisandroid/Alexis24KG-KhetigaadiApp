<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/main_collapsing"
            android:layout_width="match_parent"
            android:layout_height="@dimen/expanded_toolbar_height"
            android:background="@drawable/profile_back_banner"
            android:fitsSystemWindows="true"
            app:contentScrim="?attr/colorPrimary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_anchor="@id/main_collapsing"
                app:layout_collapseMode="pin"
                app:theme="@style/ThemeOverlay.AppCompat.Dark"
                app:title="">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="@dimen/image_final_width"
                        android:layout_height="@dimen/image_final_width" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <include
        android:id="@+id/llProgresss"
        layout="@layout/progressbar"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:scrollbars="none"
        android:visibility="visible"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="95dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/margin_5dp"
                tools:text="Pravin Shinde"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/margin_5dp"
                android:layout_marginTop="@dimen/spacing_xxsmall"
                android:gravity="center_vertical"
                android:textAppearance="?android:attr/textAppearanceSmall"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tvUserName"
                app:layout_constraintTop_toBottomOf="@id/tvUserName"
                tools:text="Pune,Maharastra" />
            <TextView
                android:id="@+id/tvRegisteredOn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/poppins"
                android:gravity="center_vertical"
                android:paddingEnd="8dp"
                android:layout_marginStart="@dimen/margin_5dp"
                android:textSize="11sp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                app:layout_constraintEnd_toStartOf="@id/btnFollow"
                app:layout_constraintStart_toStartOf="@id/tvUserName"
                app:layout_constraintTop_toBottomOf="@id/tvAddress"
                tools:text="Registered on 12 Mar 2021" />
            <Button
                android:id="@+id/btnFollow"
                style="@style/OutLineButtonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/payu_dimen_37dp"
                android:text="@string/follow"
                android:layout_marginTop="@dimen/payu_dimen_37dp"
                android:layout_marginBottom="@dimen/dimen_20dp"
                android:visibility="gone"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvUserName" />
            <include
                android:id="@+id/inUserCreditLarge"
                layout="@layout/user_credit_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvRegisteredOn" />
            <include
                android:id="@+id/inUserCredit"
                layout="@layout/user_credit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/payu_dimen_34dp"
                app:layout_constraintTop_toBottomOf="@id/inUserCreditLarge" />
            <ImageView
                android:id="@+id/iv_crop"
                android:layout_width="@dimen/margin_30dp"
                android:layout_height="@dimen/margin_30dp"
                android:layout_marginStart="@dimen/margin_5dp"
                android:layout_marginTop="@dimen/margin_10dp"
                android:layout_marginEnd="@dimen/margin_5dp"
                android:contentDescription="@string/user"
                android:src="@drawable/ic_choose_crops_48"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/inUserCredit"/>
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="@dimen/margin_30dp"
                android:layout_marginTop="@dimen/margin_10dp"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_crop"
                app:layout_constraintTop_toBottomOf="@id/inUserCredit">
                <LinearLayout
                    android:id="@+id/ll_crops"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/margin_30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
            <TextView
                android:id="@+id/tvBiagraphyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/biography"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_crop"/>
            <ImageView
                android:id="@+id/ivEditBiography"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/user"
                app:layout_constraintBottom_toBottomOf="@id/tvBiagraphyLabel"
                app:layout_constraintEnd_toEndOf="parent"/>
            <EditText
                android:id="@+id/etBiagraphy"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/margin_5dp"
                android:background="@color/labelBackGround"
                android:enabled="false"
                android:autofillHints="Biagraphy"
                android:gravity="top"
                android:padding="@dimen/margin_5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBiagraphyLabel"/>
            <TextView
                android:id="@+id/tvAwardsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/awards"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etBiagraphy" />
            <ImageView
                android:id="@+id/ivAwards"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/awards"
                android:src="@drawable/ic_edit"
                app:layout_constraintBottom_toBottomOf="@id/tvAwardsLabel"
                app:layout_constraintEnd_toEndOf="parent"/>
            <EditText
                android:id="@+id/etAwards"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/margin_5dp"
                android:background="@color/labelBackGround"
                android:enabled="false"
                android:gravity="top"
                android:padding="@dimen/margin_5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAwardsLabel"/>
            <ImageView
                android:id="@+id/ivLikeBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/like"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etAwards"/>
            <ImageView
                android:id="@+id/ivShareBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/share"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etAwards"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_10dp"
                android:background="@color/grey_line"
                app:layout_constraintTop_toBottomOf="@id/ivLikeBottom"/>
            <TextView
                android:id="@+id/tvCommentsByMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                android:drawablePadding="@dimen/margin_10dp"
                android:gravity="center_vertical"
                tools:text="post by Pravin"
                android:visibility="gone"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_post_by"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivShareBottom"
                tools:layout_editor_absoluteX="0dp" />
            <TextView
                android:id="@+id/tvDeleteAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                android:drawablePadding="@dimen/margin_10dp"
                android:gravity="center_vertical"
                android:text="@string/delete_account"
                android:visibility="visible"
                android:textColor="@color/red"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_user_black_24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCommentsByMe"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- <de.hdodenhof.circleimageview.CircleImageView
         android:id="@+id/civProfile"
         android:layout_width="90dp"
         android:layout_height="90dp"
         android:layout_gravity="center|center_horizontal"
         android:layout_marginStart="@dimen/activity_horizontal_margin"
         android:layout_marginTop="@dimen/spacing_normal"
         app:civ_border_color="@color/darkGrey"
         app:civ_border_width="1dp"
         app:finalHeight="@dimen/image_final_width"
         app:finalToolbarHeight="?attr/actionBarSize"
         app:finalXPosition="@dimen/spacing_small"
         app:finalYPosition="@dimen/spacing_small"
         app:layout_anchor="@id/main.appbar"
         app:layout_anchorGravity="bottom|start"
         app:layout_behavior="com.khetigaadi.commons.utils.AvatarImageBehavior"/>-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_gravity="center|center_horizontal"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        app:finalHeight="@dimen/image_final_width"
        app:finalToolbarHeight="?attr/actionBarSize"
        app:finalXPosition="@dimen/spacing_small"
        app:finalYPosition="@dimen/spacing_small"
        app:layout_anchor="@id/appbar"
        app:layout_anchorGravity="bottom|start"
        app:layout_behavior="com.khetigaadi.commons.utils.AvatarImageBehavior">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/civProfile"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:civ_border_color="@color/darkGrey"
            app:civ_border_width="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/tv_user_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dp"
            android:background="@drawable/user_type_background"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/margin_10dp"
            android:paddingEnd="@dimen/margin_10dp"
            tools:text="farmer"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/civProfile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/civProfile" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>