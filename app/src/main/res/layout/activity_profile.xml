<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <!--   app:contentScrim="?attr/colorPrimary"    app:contentScrim="@color/rv_back_color"  -->
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/main_collapsing"
            android:layout_width="match_parent"
            android:layout_height="@dimen/expanded_toolbar_height"
            android:background="@drawable/profile_back_banner"
            android:fitsSystemWindows="true"
            app:contentScrim="@color/white"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_anchor="@id/main_collapsing"
                app:layout_collapseMode="pin"
                app:theme="@style/ThemeOverlay.AppCompat.Dark"
                app:title="">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="@dimen/image_final_width"
                        android:layout_height="@dimen/image_final_width"/>
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <include
        android:id="@+id/llProgresss"
        layout="@layout/progressbar"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:scrollbars="none"
        android:visibility="visible"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:paddingBottom="@dimen/payu_dimen_54dp"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="95dp"
                android:fontFamily="@font/manrope_semibold"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dimen_4dp"
                android:paddingEnd="@dimen/dimen_4dp"
                tools:text="Pravin Shinde"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/margin_5dp"
                android:gravity="center_vertical"
                android:fontFamily="@font/manrope_medium"
                android:textAppearance="?android:attr/textAppearanceSmall"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tvUserName"
                app:layout_constraintTop_toBottomOf="@id/tvUserName"
                tools:text="Pune,Maharashtra"/>
            <TextView
                android:id="@+id/tvRegisteredOn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/manrope_regular"
                android:gravity="center_vertical"
                android:paddingEnd="8dp"
                android:layout_marginStart="@dimen/margin_5dp"
                android:textSize="11sp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                app:layout_constraintEnd_toStartOf="@id/btnFollow"
                app:layout_constraintStart_toStartOf="@id/tvUserName"
                app:layout_constraintTop_toBottomOf="@id/tvAddress"
                tools:text="Registered on 12 Mar 2021"/>
            <Button
                android:id="@+id/btnFollow"
                style="@style/OutLineButtonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/payu_dimen_37dp"
                android:text="@string/follow"
                android:layout_marginTop="@dimen/payu_dimen_37dp"
                android:layout_marginBottom="@dimen/dimen_20dp"
                android:visibility="gone"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvUserName"/>
            <include
                android:id="@+id/inUserCreditLarge"
                layout="@layout/user_credit_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvRegisteredOn"/>
            <include
                android:id="@+id/inUserCredit"
                layout="@layout/user_credit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/payu_dimen_24dp"
                android:layout_marginTop="@dimen/payu_dimen_14dp"
                app:layout_constraintTop_toBottomOf="@id/inUserCreditLarge"/>
            <ImageView
                android:id="@+id/iv_crop"
                android:layout_width="@dimen/margin_30dp"
                android:layout_height="@dimen/margin_30dp"
                android:layout_marginTop="@dimen/margin_32dp"
                android:layout_marginEnd="@dimen/dimen_20dp"
                android:layout_marginBottom="@dimen/dimen_5dp"
                android:contentDescription="@string/user"
                android:src="@drawable/ic_choose_crops_48"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/inUserCredit"/>
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="@dimen/dimen_50dp"
                android:id="@+id/hsvv"
                android:layout_marginTop="@dimen/dimen_20dp"
                android:scrollbars="none"
                android:padding="@dimen/margin_10dp"
                android:background="@drawable/corner_cut_text_view"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:layout_marginBottom="@dimen/dimen_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_crop"
                app:layout_constraintTop_toBottomOf="@id/inUserCredit">
                <LinearLayout
                    android:id="@+id/ll_crops"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/margin_30dp"
                    android:layout_marginBottom="@dimen/payu_dimen_10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
            <TextView
                android:id="@+id/tvMoreCrops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/payu_dimen_26dp"
                android:fontFamily="@font/manrope_medium"
                android:padding="@dimen/dimen_8dp"
                android:visibility="gone"
                android:gravity="center"
                android:minWidth="@dimen/payu_dimen_72dp"
                android:textAlignment="center"
                android:textSize="@dimen/dimen_12sp"
                android:text="@string/more"
                android:background="@drawable/more_bg_rounded_corner"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/hsvv"
                app:layout_constraintTop_toBottomOf="@id/inUserCredit"/>

            <TextView
                android:id="@+id/tvBiagraphyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:layout_marginTop="@dimen/dimen_25dp"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:text="@string/biography"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_crop"/>
            <ImageView
                android:id="@+id/ivEditBiography"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/user"
                app:layout_constraintBottom_toBottomOf="@id/tvBiagraphyLabel"
                app:layout_constraintEnd_toEndOf="parent"/>
            <EditText
                android:id="@+id/etBiagraphy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_5dp"
                android:background="@drawable/spinner_border"
                android:enabled="false"
                android:visibility="gone"
                android:autofillHints="Biagraphy"
                android:gravity="top"
                android:paddingStart="@dimen/dimen_10dp"
                android:paddingEnd="@dimen/dimen_10dp"
                android:paddingTop="@dimen/dimen_5dp"
                android:paddingBottom="@dimen/dimen_5dp"
                android:backgroundTint="@color/btnbgcolor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBiagraphyLabel"/>
            <TextView
                android:id="@+id/tvAwardsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:layout_marginTop="25dp"
                android:text="@string/awards"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etBiagraphy" />
            <ImageView
                android:id="@+id/ivAwards"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/awards"
                android:src="@drawable/ic_edit"
                app:layout_constraintBottom_toBottomOf="@id/tvAwardsLabel"
                app:layout_constraintEnd_toEndOf="parent"/>
            <EditText
                android:id="@+id/etAwards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_5dp"
                android:background="@drawable/spinner_border"
                android:enabled="false"
                android:gravity="top"
                android:paddingStart="@dimen/dimen_10dp"
                android:visibility="gone"
                android:backgroundTint="@color/btnbgcolor"
                android:paddingEnd="@dimen/dimen_10dp"
                android:paddingTop="@dimen/dimen_5dp"
                android:paddingBottom="@dimen/dimen_5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAwardsLabel"/>
            <ImageView
                android:id="@+id/ivLikeBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                android:visibility="gone"
                android:contentDescription="@string/app_name"
                android:src="@drawable/like"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etAwards"/>
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintGuide_percent="0.5"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/ivEditBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="@dimen/margin_2dp"
                android:background="@drawable/corner_cut_text_view"
                android:contentDescription="@string/app_name"
                app:drawableStartCompat="@drawable/edit"
                android:padding="@dimen/margin_10dp"
                android:drawablePadding="@dimen/margin_10dp"
                android:layout_marginEnd="@dimen/dimen_5dp"
                app:layout_constraintEnd_toStartOf="@id/guideline"
                android:text="@string/edit_profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etAwards"/>
            <TextView
                android:id="@+id/ivShareBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_5dp"
                app:layout_constraintStart_toEndOf="@id/guideline"
                android:contentDescription="@string/app_name"
                app:drawableStartCompat="@drawable/ic_share_24dp"
                android:background="@drawable/corner_cut_text_view"
                android:padding="@dimen/margin_10dp"
                android:text="@string/share"
                android:visibility="gone"
                android:drawablePadding="@dimen/margin_10dp"
                android:gravity="center|start"
                app:layout_constraintTop_toBottomOf="@id/etAwards"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dimen_30dp"
                android:background="@color/grey_line"
                app:layout_constraintTop_toBottomOf="@id/ivEditBottom"/>
            <TextView
                android:id="@+id/tvCommentsByMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                android:drawablePadding="@dimen/margin_10dp"
                android:gravity="center_vertical"
                tools:text="post by Pravin"
                android:visibility="gone"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_post_by"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivShareBottom"
                tools:layout_editor_absoluteX="0dp" />
            <TextView
                android:id="@+id/tvDeleteAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                android:drawablePadding="@dimen/margin_10dp"
                android:gravity="center_vertical"
                android:text="@string/delete_account"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/dimen_20dp"
                android:textColor="@color/red"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_user_black_24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCommentsByMe"/>
            <!--  android:background="@drawable/rounded_corner_btn"
                android:backgroundTint="@color/btnbgcolor"  -->
            <TextView
                android:id="@+id/tvDashboard"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:gravity="center|start"
                android:textSize="@dimen/dimen_14sp"
                android:layout_marginBottom="@dimen/margin_10dp"
                app:drawableStartCompat="@drawable/dashboard"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/dashboard"
                android:layout_marginTop="@dimen/dimen_50dp"
                android:drawableTint="@color/dblack"
                android:layout_height="@dimen/dimen_40dp"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:drawablePadding="@dimen/dimen_16dp"

                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDeleteAccount"/>

            <!--  android:background="@drawable/rounded_corner_btn"
               android:backgroundTint="@color/btnbgcolor"  -->

            <TextView
                android:id="@+id/tvMyOldTractors"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:gravity="center|start"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:layout_marginTop="@dimen/margin_10dp"
                android:textSize="@dimen/dimen_14sp"
                android:drawablePadding="@dimen/dimen_16dp"
                app:drawableStartCompat="@drawable/ic_new_tractor"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/my_old_tractors"
                android:drawableTint="@color/dblack"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:layout_height="@dimen/dimen_40dp"

                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDashboard"/>

            <!--   android:background="@drawable/rounded_corner_btn"
                   android:backgroundTint="@color/btnbgcolor"   -->

            <TextView
                android:id="@+id/tvMyRentTractors"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:gravity="center|start"
                android:textSize="@dimen/dimen_14sp"
                app:drawableStartCompat="@drawable/ic_new_tractor"
                android:layout_marginTop="@dimen/margin_10dp"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:fontFamily="@font/manrope_bold"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:text="@string/my_rent_tractors"
                android:drawableTint="@color/dblack"
                android:layout_height="@dimen/dimen_40dp"
                android:drawablePadding="@dimen/dimen_16dp"

                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMyOldTractors"/>

            <!-- android:background="@drawable/rounded_corner_btn"
                android:backgroundTint="@color/btnbgcolor"    -->
            <TextView
                android:id="@+id/tvBuyEnquiry"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:layout_marginTop="@dimen/margin_10dp"
                android:gravity="center|start"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:textSize="@dimen/dimen_14sp"
                app:drawableStartCompat="@drawable/information_board"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/buy_enquiry"
                android:layout_height="@dimen/dimen_40dp"
                android:drawableTint="@color/dblack"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:drawablePadding="@dimen/dimen_16dp"

                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMyRentTractors"/>

            <!-- android:background="@drawable/rounded_corner_btn"
                android:backgroundTint="@color/btnbgcolor"  -->
            <TextView
                android:id="@+id/tvMyFav"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:gravity="center|start"
                android:layout_marginTop="@dimen/margin_10dp"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:textSize="@dimen/dimen_14sp"
                android:fontFamily="@font/manrope_bold"
                app:drawableStartCompat="@drawable/favv"
                android:text="@string/my_favorites"
                android:drawableTint="@color/dblack"
                android:layout_height="@dimen/dimen_40dp"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:drawablePadding="@dimen/dimen_16dp"

                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBuyEnquiry"/>

            <!--   android:background="@drawable/rounded_corner_btn"
                android:backgroundTint="@color/btnbgcolor"  -->
            <!--      android:background="@drawable/rounded_corner_btn"
                android:backgroundTint="@color/btnbgcolor"  -->

            <TextView
                android:id="@+id/tvAddedTractor"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:gravity="center|start"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:fontFamily="@font/manrope_bold"
                android:textSize="@dimen/dimen_14sp"
                android:layout_marginStart="@dimen/dimen_4dp"
                app:drawableStartCompat="@drawable/ic_new_tractor"
                android:layout_marginTop="@dimen/margin_10dp"
                android:text="@string/my_added_tractors"
                app:drawableTint="@color/dblack"
                android:drawablePadding="@dimen/dimen_16dp"

                android:layout_height="@dimen/dimen_40dp"
                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintTop_toBottomOf="@id/tvMyFav"/>

            <TextView
                android:id="@+id/tvAddOwnerTractor"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginBottom="@dimen/dimen_30dp"
                android:fontFamily="@font/manrope_bold"
                android:textSize="@dimen/dimen_14sp"
                android:paddingBottom="@dimen/margin_8dp"
                android:background="@drawable/dashed_border"
                android:layout_marginTop="@dimen/dimen_20dp"
                android:layout_marginStart="@dimen/dimen_20dp"
                android:layout_marginEnd="@dimen/dimen_16dp"
                app:drawableTint="@color/black"
                android:text="@string/add_own_tractor"
                android:layout_height="@dimen/dimen_40dp"
                app:layout_constraintTop_toBottomOf="@id/tvAddedTractor"/>

            <TextView
                android:id="@+id/tvProfileSettings"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:gravity="center|start"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:fontFamily="@font/manrope_bold"
                android:textSize="@dimen/dimen_14sp"
                android:layout_marginStart="@dimen/dimen_4dp"
                app:drawableStartCompat="@drawable/account_settings"
                android:layout_marginTop="@dimen/payu_dimen_24dp"
                android:text="@string/profile_settings"
                android:drawablePadding="@dimen/dimen_16dp"

                android:drawableTint="@color/dblack"
                android:layout_height="@dimen/dimen_40dp"
                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintTop_toBottomOf="@id/tvAddOwnerTractor"/>
            <TextView
                android:id="@+id/tvProfileEditt"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:gravity="center|start"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:fontFamily="@font/manrope_bold"
                android:textSize="@dimen/dimen_14sp"
                android:layout_marginStart="@dimen/dimen_4dp"
                app:drawableStartCompat="@drawable/edit"

                android:drawableTint="@color/dblack"
                android:layout_marginTop="@dimen/margin_10dp"
                android:text="@string/edit_profile"
                android:drawablePadding="@dimen/dimen_16dp"
                android:layout_height="@dimen/dimen_40dp"
                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintTop_toBottomOf="@id/tvProfileSettings"/>

            <TextView
                android:id="@+id/tvChangeLang"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:gravity="center|start"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:fontFamily="@font/manrope_bold"
                android:textSize="@dimen/dimen_14sp"
                android:layout_marginStart="@dimen/dimen_4dp"
                app:drawableStartCompat="@drawable/languages_white_24"

                app:drawableTint="@color/dblack"
                android:layout_marginTop="@dimen/margin_10dp"
                android:text="@string/change_language"
                android:drawablePadding="@dimen/dimen_16dp"
                android:layout_height="@dimen/dimen_40dp"
                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintTop_toBottomOf="@id/tvProfileEditt"/>

            <TextView
                android:id="@+id/tvShareProfv"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center|start"
                android:gravity="center|start"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:fontFamily="@font/manrope_bold"
                android:textSize="@dimen/dimen_14sp"
                android:layout_marginStart="@dimen/dimen_4dp"
                app:drawableStartCompat="@drawable/right"

                android:clickable="true"
                android:enabled="true"
                app:drawableTint="@color/dblack"
                android:layout_marginTop="@dimen/margin_10dp"
                android:text="@string/share"
                android:drawablePadding="@dimen/dimen_16dp"
                android:layout_height="@dimen/dimen_40dp"
                app:drawableEndCompat="@drawable/ic_right_arrow_black_24dp"
                app:layout_constraintTop_toBottomOf="@id/tvChangeLang"/>

            <TextView
                android:id="@+id/tvLogout"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginBottom="@dimen/dimen_20dp"
                android:paddingBottom="@dimen/dimen_4dp"
                android:backgroundTint="@color/btnbgcolor"
                android:fontFamily="@font/manrope_bold"
                android:textSize="@dimen/dimen_14sp"
                android:background="@drawable/spinner_border"
                android:layout_marginTop="@dimen/dimen_20dp"
                android:layout_marginStart="@dimen/dimen_4dp"
                android:text="@string/logout"
                android:layout_height="@dimen/dimen_40dp"
                app:layout_constraintTop_toBottomOf="@id/tvShareProfv"/>

     </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
