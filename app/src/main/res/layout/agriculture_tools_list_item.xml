<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/payu_dimen_240dp"
    android:layout_margin="@dimen/dimen_4dp"
    android:backgroundTint="@color/white"
    android:background="@color/white"
    app:cardCornerRadius="@dimen/payu_dimen_12dp"
    android:orientation="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="174dp"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_corner"
        android:backgroundTint="@color/white"
        android:gravity="center">
        <TextView
            android:id="@+id/tvHints"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="#78C841"
            android:padding="@dimen/margin_2dp"
            android:visibility="gone"
            android:textSize="@dimen/dimen_10sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:layout_margin="@dimen/margin_10dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:background="@color/white"
            android:minHeight="@dimen/payu_dimen_150dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toTopOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tvDiscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dimen_5dp"
            android:background="@drawable/rounded_corner"
            android:fontFamily="@font/manrope_medium"
            android:visibility="gone"
            android:backgroundTint="@color/offBg"
            android:textAlignment="center"
            android:gravity="center"
            android:paddingStart="@dimen/dimen_5dp"
            android:paddingTop="@dimen/dimen_3dp"
            android:textSize="@dimen/dimen_12sp"
            android:paddingEnd="@dimen/dimen_5dp"
            android:paddingBottom="@dimen/dimen_3dp"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="- 10%"/>
        <!--
            android:drawableStart="@drawable/like12_" -->
        <TextView
            android:id="@+id/ivSavee"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/payu_dimen_22dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="@dimen/margin_10dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/title"
            style="@style/ItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:textSize="@dimen/payu_dimen_15sp"
            android:textColor="@color/black"
            android:fontFamily="@font/manrope_semibold"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toTopOf="@id/tvDiscPrice"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Samsung 192 ltr 2 star dddd RR19M27RJ"/>
        <TextView
            android:id="@+id/tvDiscPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/payu_dimen_9dp"
            android:paddingBottom="@dimen/dimen_4dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/manrope_bold"
            android:textColor="@color/dblack"
            android:textSize="@dimen/dimen_14sp"
            app:layout_constraintHorizontal_chainStyle="packed"
            android:layout_marginEnd="@dimen/dimen_2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/payu_dimen_6dp"
            app:layout_constraintStart_toEndOf="@+id/tvPrice"
            tools:text="100"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/priceGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chainUseRtl="false"
            app:constraint_referenced_ids="tvPrice,tvDiscPrice"/>
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/dimen_5dp"
            android:fontFamily="@font/manrope_regular"
            android:includeFontPadding="false"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:textColor="#909191"
            android:textSize="@dimen/dimen_12sp"
            android:layout_marginStart="@dimen/margin_10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_bias="0.5"
            tools:text="100"/>
        <!-- android:paddingBottom="@dimen/dimen_5dp"  -->
        <ImageView
            android:id="@+id/ivCartV"
            style="@style/ProductItemDiscPer"
            android:layout_width="@dimen/dimen_16dp"
            android:layout_height="@dimen/dimen_16dp"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:layout_marginEnd="@dimen/payu_dimen_6dp"
            android:layout_marginBottom="@dimen/margin_15dp"
            android:src="@drawable/ic_shopping_cart_black_24dp"
            android:textSize="@dimen/dimen_12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvDiscPrice"/>


        <TextView
            android:id="@+id/tvDiscPer"
            style="@style/ProductItemDiscPer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/margin_10dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/greenHaze"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvPrice"
            tools:text="10% off"/>
        <TextView
            android:id="@+id/tvCommission"
            style="@style/ProductItemDiscPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_10dp"
            android:fontFamily="@font/poppins"
            android:layout_marginBottom="@dimen/margin_10dp"
            android:background="@drawable/rounded_corner_btn_with_light_color"
            android:paddingStart="@dimen/dimen_5dp"
            android:textSize="@dimen/dimen_10sp"
            android:visibility="gone"
            android:paddingEnd="@dimen/dimen_5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="commisstion 100"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>