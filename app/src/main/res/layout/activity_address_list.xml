<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".news.activity.NewsCommentReplyListActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbarI"
            layout="@layout/ecom_toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_corner22"
        android:backgroundTint="@color/rv_back_color"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <include
            android:id="@+id/llProgresss"
            layout="@layout/progressbar"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAddressList"
            android:layout_width="match_parent"
            android:paddingTop="@dimen/dimen_8dp"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dimen_120dp"/>
        <include
            android:id="@+id/inInputComment"
            layout="@layout/comment_input"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_star_black_24dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/dimen_50dp"
            android:layout_alignParentEnd="true"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/dimen_10dp"
            android:tint="@color/gray"
            app:backgroundTint="@color/white"
            app:layout_anchorGravity="bottom|start"
            tools:ignore="RelativeOverlap"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_anchorGravity="bottom|start"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/payu_dimen_54dp"
            android:orientation="horizontal">
            <!--   style="@style/ButtonStyleFilledPrimary"  -->
            <TextView
                android:id="@+id/btnAddAddress"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dimen_5dp"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:minHeight="@dimen/payu_dimen_45dp"
                android:background="@drawable/btn_rectangle_outline_bg_red"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/red"
                android:text="@string/add_address"
                android:textAllCaps="false"/>
            <!--   style="@style/ButtonStyleFilledRed" -->
            <TextView
                android:id="@+id/btnContinue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/payu_dimen_45dp"
                android:background="@drawable/btn_rectangle_outline_bg_red"
                android:textColor="@color/red"
                android:layout_marginStart="@dimen/dimen_5dp"
                android:textAlignment="center"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginEnd="@dimen/dimen_10dp"
                android:text="@string/Continue"
                android:textAllCaps="false"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>