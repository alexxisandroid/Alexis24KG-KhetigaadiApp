            <LinearLayout
                android:id="@+id/lltopp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/rounded_bottom_corner"
                android:backgroundTint="#F5F5F5"
                android:paddingBottom="@dimen/dimen_20dp"
                android:orientation="vertical">
                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/viewPager"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <me.relex.circleindicator.CircleIndicator
                    android:id="@+id/viewPagerIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    app:ci_drawable="@drawable/sselectedv"
                    app:ci_drawable_unselected="@drawable/unselected"
                    app:ci_height="5dp"
                    android:padding="10dip"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:paddingEnd="@dimen/dimen_10dp"
                    app:ci_gravity="center"
                    app:ci_margin="@dimen/payu_dimen_7dp"
                    app:ci_width="@dimen/dimen_16dp"
                    app:layout_constraintTop_toBottomOf="@id/viewPager"/>
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toBottomOf="@id/viewPager"
                    android:visibility="gone"/>

                <ProgressBar
                    android:id="@+id/progressBarr"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:visibility="gone"
                    android:layout_alignParentBottom="true"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar_style" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/payu_dimen_28dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/viewPagerIndicator"/>
            </LinearLayout>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/my_sticky_button"
                style="@style/ShimmerStyle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/payu_dimen_250dp"
                app:layout_constraintTop_toBottomOf="@id/lltopp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin_8dp">
                    <Button
                        android:id="@+id/btnAddToCart"
                        android:layout_width="0dp"
                        style="@style/ButtonStyleFilledRed"
                        android:layout_height="match_parent"
                        android:layout_weight=".5"/>
                    <Button
                        android:id="@+id/btnExpertAdvice"
                        style="@style/ButtonStyleFilledRed"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/margin_2dp"
                        android:layout_weight=".5"/>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <com.andexert.library.RippleView
                android:id="@+id/rvTrendingProductsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/my_sticky_button">
                <TextView
                    android:id="@+id/tvTrendingProductsLabel"
                    style="@style/homePageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold"
                    android:textSize="@dimen/dimen_16sp"
                    android:layout_marginTop="@dimen/dimen_10dp"
                    android:layout_marginBottom="@dimen/dimen_10dp"
                    android:layout_alignParentEnd="true"
                    android:text="@string/trending_products"/>

            </com.andexert.library.RippleView>
            <LinearLayout
                android:id="@+id/llincludeTrendingLarge"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/shopMiddleBanner"
                app:layout_constraintHorizontal_chainStyle="packed"
                android:padding="@dimen/dimen_4dp"
                android:background="@drawable/rounded_corner22"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:layout_marginEnd="@dimen/dimen_10dp"
                android:backgroundTint="@color/rv_back_color"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvTrendingProductsLabel"
                android:orientation="horizontal">
                <!--
                android:layout_marginStart="@dimen/dimen_4dp"
                android:layout_marginEnd="@dimen/dimen_4dp"
                android:layout_marginBottom="@dimen/dimen_4dp"
                 -->
                <include
                    android:id="@+id/includeTrendingLarge"
                    layout="@layout/trending_list_item_large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/gray_light"
                    app:layout_constraintBottom_toTopOf="@+id/shopMiddleBanner"
                    app:layout_constraintEnd_toStartOf="@+id/guideline"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    android:layout_marginEnd="@dimen/dimen_1dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rvTrendingProductsLabel"/>
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_10dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toEndOf="@+id/includeTrendingLarge"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.65"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        android:id="@+id/includeTrending1"
                        layout="@layout/trending_list_item"
                        android:layout_width="match_parent"
                        android:backgroundTint="@color/gray_light"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dimen_1dp"
                        android:layout_marginStart="@dimen/dimen_2dp"
                        android:background="@drawable/rounded_corner"
                        android:layout_marginBottom="@dimen/dimen_2dp"
                        app:layout_constraintBottom_toTopOf="@id/includeTrending2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/guideline"
                        app:layout_constraintTop_toBottomOf="@+id/rvTrendingProductsLabel"/>
                    <include
                        android:id="@+id/includeTrending2"
                        layout="@layout/trending_list_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_2dp"
                        android:backgroundTint="@color/gray_light"
                        android:layout_marginStart="@dimen/dimen_2dp"
                        android:layout_marginEnd="@dimen/dimen_1dp"
                        app:layout_constraintBottom_toBottomOf="@id/includeTrendingLarge"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/guideline"
                        app:layout_constraintTop_toBottomOf="@id/includeTrending1"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupTrending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <!--                android:visibility="visible"-->
            <!--                app:constraint_referenced_ids="rvTrendingProductsLabel,includeTrendingLarge,includeTrending1,includeTrending2"/>-->
            <!--            -->
            <TextView
                style="@style/seeMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ad"
                android:textSize="@dimen/payu_dimen_8sp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/shopMiddleBanner"
                app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/shopMiddleBanner"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/dimen_25dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/llincludeTrendingLarge"
                tools:visibility="visible">
                <ImageView
                    android:id="@+id/ivShopMiddleBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
            </androidx.cardview.widget.CardView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHomeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_2dp"
                android:layout_marginTop="@dimen/dimen_10dp"
                android:background="@color/rv_back_color"

                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/shopMiddleBanner"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_80dp"
                app:layout_constraintTop_toBottomOf="@id/rvHomeList"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        style="@style/Widget.BottomNavigationView"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:itemIconTint="@color/colorPrimary"
        app:itemRippleColor="@color/colorPrimary"
        app:itemTextAppearanceActive="@style/BottomNavigationView.Active"
        app:itemTextAppearanceInactive="@style/BottomNavigationView.InActive"
        app:itemTextColor="@color/colorPrimary"
        app:labelVisibilityMode="labeled"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/ecom_bottom_bar_navigation_items"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>