<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:focusableInTouchMode="true"
    android:scrollbars="none"
    tools:context="com.khetigaadi.commons.fragments.HomeFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <!--  android:fontFamily="@font/poppins"  -->
        <TextView
            android:id="@+id/tvSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginBottom="@dimen/dimen_30dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:background="@drawable/bg_rounded_search_box_home"
            android:clickable="true"
            android:drawablePadding="@dimen/dimen_5dp"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:gravity="center_vertical|center_horizontal"
            android:paddingStart="@dimen/dimen_20dp"
            android:paddingEnd="@dimen/dimen_20dp"
            android:textAlignment="center"
            android:ellipsize="end"
            android:paddingTop="@dimen/dimen_10dp"
            android:paddingBottom="@dimen/margin_10dp"
            android:text="@string/search_tractors_harvesters_implements"
            android:textColor="@color/black"
            android:textSize="@dimen/dimen_13sp"
            android:alpha="0.8"
            app:drawableEndCompat="@drawable/ic_voice_recording"
            app:drawableStartCompat="@drawable/ic_search"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:focusable="true"/>
        <View
            android:id="@+id/viewVoiceRecording"
            android:layout_width="50dp"
            android:layout_height="55dp"
            app:layout_constraintBottom_toBottomOf="@id/tvSearch"
            app:layout_constraintEnd_toEndOf="@id/tvSearch"
            app:layout_constraintTop_toTopOf="@id/tvSearch"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:fitsSystemWindows="true"
            android:layout_marginTop="@dimen/dimen_10dp"
            app:layout_constraintTop_toBottomOf="@id/tvSearch"
            tools:visibility="visible"/>
        <me.relex.circleindicator.CircleIndicator
            android:id="@+id/indicator"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:ci_drawable="@drawable/ic_circle_red_24dp"
            app:ci_drawable_unselected="@drawable/ic_circle_black_24dp"
            app:ci_height="6dp"
            app:ci_margin="@dimen/dimen_4dp"
            android:layout_marginBottom="@dimen/dimen_10dp"
            app:ci_width="6dp"
            app:layout_constraintTop_toBottomOf="@id/viewPager"/>
        <LinearLayout
            android:id="@+id/llProgressBanner"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/indicator"
            tools:visibility="visible">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvProfileUpdate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:background="@color/labelBackGround"
            android:gravity="center"
            android:padding="2dp"
            android:text="@string/please_complete_your_profile"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/red"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/llProgressBanner"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_4dp"
            android:padding="@dimen/dimen_5dp"
            app:constraint_referenced_ids="cvNewTractor,cvOldTractor,cvSellTractor,cvShop,cvHarvester,cvImplements,cvVideo,cvCompare,cvTyre,cvNews,cvInsurance,cvFinance"
            app:flow_maxElementsWrap="3"
            app:flow_wrapMode="aligned"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvProfileUpdate"
            tools:visibility="gone"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvNewTractor"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:padding="@dimen/dimen_5dp"
            app:iconImage="@drawable/ic_new_tractor_home"
            custom:titleText="@string/new_tractor"
            custom:viewBackgroundColor="@color/mediumAquamarine"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvOldTractor"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:padding="@dimen/dimen_5dp"
            app:iconImage="@drawable/ic_old_tractor_home"
            custom:titleText="@string/buy_used"
            custom:viewBackgroundColor="@color/robinEggBlue"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvSellTractor"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:padding="@dimen/dimen_5dp"
            app:iconImage="@drawable/ic_sell_tractor_home"
            custom:titleText="@string/sell_used"
            custom:viewBackgroundColor="@color/mustard"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvShop"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:padding="@dimen/dimen_5dp"
            app:iconImage="@drawable/ic_shop_home"
            custom:titleText="@string/shop"
            custom:viewBackgroundColor="@color/mayaBlue"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvHarvester"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:padding="@dimen/dimen_5dp"
            app:iconImage="@drawable/ic_harvester_home"
            custom:titleText="@string/harvester"
            custom:viewBackgroundColor="#e66767"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvImplements"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:padding="@dimen/dimen_5dp"
            app:iconImage="@drawable/ic_implement_home"
            custom:titleText="@string/implement"
            custom:viewBackgroundColor="#5ca7f9"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvVideo"
            android:layout_width="0dp"
            android:layout_height="106dp"
            android:padding="@dimen/dimen_5dp"
            android:visibility="gone"
            app:iconImage="@drawable/ic_video_home"
            custom:titleText="@string/video"
            custom:viewBackgroundColor="@color/celestialBlue"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvCompare"
            android:layout_width="0dp"
            android:layout_height="106dp"
            android:padding="@dimen/dimen_5dp"
            android:visibility="gone"
            app:iconImage="@drawable/ic_compare_home"
            custom:titleText="@string/compare"
            custom:viewBackgroundColor="@color/Glaucous"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvTyre"
            android:layout_width="0dp"
            android:layout_height="106dp"
            android:padding="@dimen/dimen_5dp"
            android:visibility="gone"
            app:iconImage="@drawable/ic_tyres_home"
            custom:titleText="@string/tyre"
            custom:viewBackgroundColor="@color/oliveGreen"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvNews"
            android:layout_width="0dp"
            android:layout_height="106dp"
            android:padding="@dimen/dimen_5dp"
            android:visibility="gone"
            app:iconImage="@drawable/ic_news_home"
            custom:titleText="@string/news"
            custom:viewBackgroundColor="@color/Saffron"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvInsurance"
            android:layout_width="0dp"
            android:layout_height="106dp"
            android:padding="@dimen/dimen_5dp"
            android:visibility="gone"
            app:iconImage="@drawable/ic_insurance_home"
            custom:titleText="@string/insurance"
            custom:viewBackgroundColor="#63cdda"/>
        <com.khetigaadi.customeview.HomeMenuOptionView
            android:id="@+id/cvFinance"
            android:layout_width="0dp"
            android:layout_height="106dp"
            android:padding="@dimen/dimen_5dp"
            android:visibility="gone"
            app:iconImage="@drawable/ic_finance_home"
            custom:titleText="@string/finance"
            custom:viewBackgroundColor="#1dd1a1"/>
<!-- android:fontFamily="@font/poppins_semi_bold"   -->


        <TextView
            android:id="@+id/tvMainMenuViewMore"
            android:layout_width="match_parent"
            android:layout_height="37.33dp"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/dimen_20dp"
            android:layout_marginEnd="@dimen/dimen_20dp"
            android:layout_marginBottom="@dimen/dimen_40dp"
            android:background="@drawable/rounded_corner_12dp"
            android:backgroundTint="#cdcecf"
            android:drawablePadding="-112dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:paddingEnd="116dp"
            android:paddingStart="@dimen/dimen_0dp"
            android:textStyle="bold"
            android:text="@string/view_more"
            android:textColor="@color/charcoal"
            android:textSize="13sp"
            app:drawableEndCompat="@drawable/ic_down_arrow_black_24dp"
            app:drawableTint="@color/charcoal"
            app:layout_constraintTop_toBottomOf="@id/flow"/>

        <!--  style="?attr/materialCardViewFilledStyle"   <com.google.android.material.card.MaterialCardView-->
        <androidx.cardview.widget.CardView
            android:id="@+id/llIsOwner"
            android:layout_width="match_parent"
            android:layout_height="137dp"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:layout_marginEnd="@dimen/dimen_10dp"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginTop="@dimen/dimen_30dp"
            app:cardBackgroundColor="#cedeee"
            app:layout_constraintTop_toBottomOf="@id/tvMainMenuViewMore">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:padding="10dp">
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.3"/>
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:paddingTop="@dimen/dimen_10dp"
                    android:src="@drawable/ic_old_tractor_home"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guideline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
    <!-- android:fontFamily="@font/poppins_bold"
       android:fontFamily="@font/poppins_medium"-->
                <TextView
                    android:id="@+id/tvTractorOwnerHindi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dimen_10dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="@string/r_u_tractor_owner"
                    android:textColor="@color/charcoal"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guideline"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvDoYouOwnTractor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginBottom="@dimen/dimen_10dp"
                    android:gravity="center"
                    android:text="@string/want_buy_tract"
                    android:textColor="@color/charcoal"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guideline"
                    app:layout_constraintTop_toBottomOf="@id/tvTractorOwnerHindi"/>
<!--    style="@style/OutLineButtonStyleSmall" -->
                <TextView
                    android:id="@+id/btnIsOwner"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_35dp"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:text="@string/click_here"
                    android:textAlignment="center"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:outlineAmbientShadowColor="@color/red"
                    android:textColor="@color/red"
                    android:background="@drawable/btn_rectangle_outline_bg_red"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:padding="@dimen/dimen_10dp"
                    app:layout_constraintStart_toEndOf="@id/guideline"
                    app:layout_constraintTop_toBottomOf="@id/tvDoYouOwnTractor"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <include
            android:id="@+id/includePopularTractors"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/llIsOwner"/>
        <include
            android:id="@+id/includeBrands"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/includePopularTractors"/>
        <!--  style="?attr/materialCardViewFilledStyle" -->
        <androidx.cardview.widget.CardView
            android:id="@+id/mcvBanner1"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_margin="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/includeBrands">
            <ImageView
                android:id="@+id/ivBanner1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                tools:src="@drawable/profile_back_banner"/>
        </androidx.cardview.widget.CardView>
        <include
            android:id="@+id/includeTractors"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/mcvBanner1"/>
        <include
            android:id="@+id/includeStates"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/includeTractors"/>
        <include
            android:id="@+id/includeHarvester"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/includeStates"/>
        <!--    style="?attr/materialCardViewFilledStyle"  -->
        <androidx.cardview.widget.CardView
            android:id="@+id/mcvBanner2"
            android:layout_width="match_parent"
            android:layout_height="137dp"
            android:layout_margin="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/includeHarvester">
            <ImageView
                android:id="@+id/ivBanner2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                tools:src="@drawable/profile_back_banner"/>
        </androidx.cardview.widget.CardView>
        <include
            android:id="@+id/includeSmallFarmMachinery"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/mcvBanner2"/>
        <include
            android:id="@+id/includeCompare"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/includeSmallFarmMachinery"/>
        <include
            android:id="@+id/includeNews"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/includeCompare"/>
<!--  style="?attr/materialCardViewFilledStyle"  -->
        <androidx.cardview.widget.CardView
            android:id="@+id/mcvBanner3"
            android:layout_width="match_parent"
            android:layout_height="137dp"
            android:layout_margin="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/includeNews">
            <ImageView
                android:id="@+id/ivBanner3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                tools:src="@drawable/profile_back_banner"/>
        </androidx.cardview.widget.CardView>
        <include
            android:id="@+id/includeVideos"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/mcvBanner3"/>
        <include
            android:id="@+id/includeTestimonials"
            layout="@layout/home_list_new_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/includeVideos"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

