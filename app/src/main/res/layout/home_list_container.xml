<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:showIn="@layout/home">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/margin_15dp">
        <com.andexert.library.RippleView
            android:id="@+id/rvLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
<!--            <TextView-->
<!--                android:id="@+id/tvLabel"-->
<!--                style="@style/homePageLabel"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:fontFamily="@font/poppins_bold"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_alignParentStart="true"-->
<!--                android:layout_alignParentEnd="true"-->
<!--                tools:text="Label" />-->

<!--            <TextView-->
<!--                android:id="@+id/tvLabel"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_alignParentStart="true"-->
<!--                style="@style/homePageLabel"-->
<!--                android:layout_alignParentEnd="true"-->
<!--                android:textStyle="bold"-->
<!--                android:fontFamily="@font/poppins_bold"-->
<!--                android:textSize="18sp"-->
<!--                app:layout_constraintTop_toTopOf="parent"-->
<!--                tools:text="Label"/>-->

            <TextView
                android:id="@+id/tvLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                style="@style/homePageLabel"
                android:layout_alignParentEnd="true"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:textSize="18sp"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Label"/>
        </com.andexert.library.RippleView>
        <TextView
            android:id="@+id/tvSeeMore"
            style="@style/seeMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/viewAll"
            android:textAllCaps="true"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintBottom_toBottomOf="@id/rvLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/rvLabel" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/rvLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>