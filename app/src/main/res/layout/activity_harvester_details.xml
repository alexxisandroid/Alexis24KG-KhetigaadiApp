<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>-
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dimen_60dp"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <androidx.cardview.widget.CardView
            android:id="@+id/cvCapacitySpecification"
            android:layout_width="match_parent"
            android:backgroundTint="@color/white"
            android:background="@color/white"
            android:layout_height="wrap_content"
            android:layout_margin="4dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/detailsBackground"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10dp">
                <ImageView
                    android:id="@+id/ivImage"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvName"
                    style="@style/homePageLabelTl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:paddingTop="@dimen/margin_5dp"
                    android:paddingEnd="@dimen/margin_5dp"
                    android:paddingStart="@dimen/dimen_10dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/dimen_16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivImage"
                    tools:text="Same Deutz Fahr Agrolux 80 Profiline"/>

<!--                <TextView -->
<!--                    android:id="@+id/tvViews"-->
<!--                    style="@style/ViewsRounded"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_gravity="center_vertical"-->
<!--                    android:layout_marginStart="@dimen/margin_10dp"-->
<!--                    android:layout_marginTop="@dimen/margin_10dp"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toTopOf="parent"-->
<!--                    tools:text="0k"/>-->

                <TextView
                    android:id="@+id/tvViews"
                    style="@style/ViewsRoundedSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginTop="@dimen/dimen_10dp"
                    android:layout_marginStart="@dimen/dimen_10dp"
                    android:gravity="start|center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="0k" />

                <ImageView
                    android:id="@+id/ivShare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="@dimen/margin_15dp"
                    android:src="@drawable/ic_share_black_24dp"
                    app:layout_constraintBottom_toBottomOf="@id/ivImage"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:contentDescription="@string/share"/>
                <TextView
                    android:id="@+id/tvType"
                    style="@style/TractorListItemTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:paddingTop="@dimen/dimen_2dp"
                    android:paddingEnd="@dimen/margin_5dp"
                    android:paddingStart="@dimen/dimen_10dp"
                    android:layout_marginBottom="@dimen/dimen_16dp"
                    android:textColor="@color/black"
                    android:paddingBottom="@dimen/dimen_16dp"
                    android:textSize="@dimen/dimen_12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvName"
                    tools:text="Same Deutz Fahr Agrolux 80 Profiline"/>
                <include
                    android:id="@+id/includeSimilar"
                    layout="@layout/home_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/tvType"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="5sp"
        android:layout_marginBottom="@dimen/dimen_10dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:padding="@dimen/margin_5dp">
        <TextView
            android:id="@+id/btnOnPrice"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_40dp"
            android:layout_margin="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp"

            android:minHeight="@dimen/payu_dimen_45dp"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:textAlignment="center"
            android:textColor="@color/red"
            android:gravity="center"

            android:text="@string/getPrice"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnRequestForDemo"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible"/>
        <TextView
            android:id="@+id/btnRequestForDemo"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_40dp"
            android:layout_margin="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:autoLink="web"
            android:text="@string/request_for_demo"

            android:minHeight="@dimen/payu_dimen_45dp"
            android:background="@drawable/btn_rectangle_outline_bg_red"
            android:textAlignment="center"
            android:textColor="@color/red"
            android:gravity="center"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/btnOnPrice"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/llProgresss"
        layout="@layout/progressbar"
        tools:visibility="gone"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
