<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".commons.fragments.FeedbackFragment">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFeedbackType"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_16dp"
        android:hint="@string/type"
        app:errorTextAppearance="@style/error_appearance"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actvFeedbackType"
            style="@style/Widget.MaterialComponents.AutoCompleteTextView.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ems="10"
            android:paddingBottom="@dimen/dimen_15dp"
            android:fontFamily="@font/poppins_medium"
            android:inputType="none"
            android:maxLength="30"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_layout_comment"
        style="@style/FormTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:hint="@string/comments"
        app:errorTextAppearance="@style/error_appearance"
        app:layout_constraintTop_toBottomOf="@id/tilFeedbackType">
        <EditText
            android:id="@+id/tvComments"
            style="@style/FormEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:ems="10"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:maxLength="300"
            android:minHeight="120dp"/>
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout
        android:id="@+id/llProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>
    </LinearLayout>
    <com.andexert.library.RippleView
        android:id="@+id/riSubmit"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_gravity="bottom"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button
            android:id="@+id/btnSubmit"
            style="@style/ButtonStyleFilledRed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/btn_submit"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@android:color/white"/>
    </com.andexert.library.RippleView>
</androidx.constraintlayout.widget.ConstraintLayout>