<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".commons.activities.SearchActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/cxzc"
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="?actionBarSize"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <HorizontalScrollView
            android:id="@+id/hcFilterGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dimen_5dp"
                android:paddingEnd="@dimen/dimen_5dp"
                app:singleLine="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNewTractor"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:checked="true"
                    android:text="@string/tractors"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipImplements"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/implement"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHarvester"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/harvester"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipProduct"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/products"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUsedTractor"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/used_tractors"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <View
            android:id="@+id/vDivider"
            android:layout_width="match_parent"
            android:background="@color/gray"
            android:layout_height="@dimen/dimen_1dp"
            app:layout_constraintTop_toBottomOf="@id/hcFilterGroup"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/newTractorSearchRes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="@dimen/dimen_20dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vDivider"/>
        <include
            android:id="@+id/llProgresss"
            layout="@layout/progressbar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>