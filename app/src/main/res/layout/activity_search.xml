<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".commons.activities.SearchActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/cxzc"
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"
        android:layout_height="?actionBarSize"
        android:theme="@style/AppTheme.AppBarOverlay">
        <include
            android:id="@+id/toolbars"
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/rounded_corner2"
        android:backgroundTint="@color/rv_back_color"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.cardview.widget.CardView
           android:id="@+id/lsView"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginBottom="@dimen/dimen_20dp"
           android:elevation="@dimen/dimen_2dp"
           app:cardElevation="@dimen/dimen_2dp"
           app:cardCornerRadius="@dimen/dimen_10dp"
           android:minHeight="@dimen/payu_dimen_54dp"
           android:background="@drawable/btn_rectangle_bg_primary"
           android:backgroundTint="@color/white"
           app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.SearchView
           android:id="@+id/sView"
           android:layout_width="match_parent"
           android:background="@null"
           android:layout_height="match_parent"
            app:queryBackground="@null"
            app:iconifiedByDefault="false"
            android:hint="@string/search"
            android:layout_gravity="center|start"
            android:gravity="start"
            android:layout_marginStart="@dimen/dimen_10dp"
           app:layout_constraintTop_toTopOf="parent">
            <requestFocus/>
        </androidx.appcompat.widget.SearchView>
       </androidx.cardview.widget.CardView>
        <HorizontalScrollView
            android:id="@+id/hcFilterGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginEnd="@dimen/dimen_10dp"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginBottom="@dimen/dimen_5dp"
            app:layout_constraintTop_toBottomOf="@id/lsView">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dimen_5dp"
                android:paddingEnd="@dimen/dimen_5dp"
                app:singleLine="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNewTractor"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:checked="true"
                    android:text="@string/tractors"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipImplements"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/implement"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHarvester"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/harvester"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipProduct"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/products"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUsedTractor"
                    style="@style/CustomSuggestionChipFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/used_tractors"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:checkedIcon="@null"
                    app:chipBackgroundColor="@drawable/chip_filter_background"
                    app:layout_constraintEnd_toStartOf="@+id/chipHashTag"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <View
            android:id="@+id/vDivider"
            android:layout_width="match_parent"
            android:background="@color/gray_light"
            android:layout_height="@dimen/dimen_1dp"
            app:layout_constraintTop_toBottomOf="@id/hcFilterGroup"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/newTractorSearchRes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="@dimen/dimen_40dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vDivider"/>

        <LinearLayout
            android:id="@+id/llEmptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lsView"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="@string/app_name"
                android:adjustViewBounds="true"
                android:alpha="0.5"
                android:src="@drawable/baseline_empty_24"
                app:tint="@color/blackLight" />

            <TextView
                android:id="@+id/tvEmptyMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/manrope_semibold"
                android:text="@string/no_data_found"
                android:alpha="0.5"
                android:textColor="@color/blackLight"
                android:textSize="16sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/llProgresss"
        layout="@layout/progressbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_gravity="center"
        app:layout_constraintTop_toBottomOf="@id/newTractorSearchRes"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
</LinearLayout>