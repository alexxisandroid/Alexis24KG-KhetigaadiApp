<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".tractor.sellTractorNewUi.SellTractorImages">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/dimen_50dp"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_camera_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:maxLines="2"
            android:padding="10dp"
            android:text="@string/image_hint"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btn_image_next"
            android:layout_marginBottom="@dimen/dimen_4dp"
            android:layout_below="@+id/tv_camera_hint">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight=".50"
                        android:padding="5dp"
                        app:cardCornerRadius="8dp">

                        <ImageView
                            android:id="@+id/iv_first"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/btn_selector"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_camara" />
                    </androidx.cardview.widget.CardView>

                    <!-- COLUMN 2  -->

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight=".50"
                        android:padding="5dp"
                        app:cardCornerRadius="8dp">

                        <ImageView
                            android:id="@+id/iv_second"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/btn_selector"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_camara" />

                    </androidx.cardview.widget.CardView>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight=".50"
                        android:padding="5dp"
                        app:cardCornerRadius="8dp">

                        <ImageView
                            android:id="@+id/iv_third"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/btn_selector"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_camara" />

                    </androidx.cardview.widget.CardView>

                    <!-- COLUMN 2  -->

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight=".50"
                        android:padding="5dp"
                        app:cardCornerRadius="8dp">

                        <ImageView
                            android:id="@+id/iv_fourth"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/btn_selector"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_camara" />

                    </androidx.cardview.widget.CardView>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <!-- ROW 3  -->
                <!-- COLUMN 1  -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight=".50"
                        android:padding="5dp"
                        app:cardCornerRadius="8dp">

                        <ImageView
                            android:id="@+id/iv_fifth"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/btn_selector"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_camara" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight=".50"
                        android:padding="5dp"
                        app:cardCornerRadius="8dp">

                        <ImageView
                            android:id="@+id/iv_sixth"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/btn_selector"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_camara" />
                    </androidx.cardview.widget.CardView>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>

        <TextView
            android:id="@+id/btn_image_next"
            style="@style/ButtonStyleFilledRed"
            android:layout_width="match_parent"
            android:layout_margin="@dimen/dimen_10dp"
            android:layout_height="@dimen/payu_dimen_45dp"

            android:outlineAmbientShadowColor="@color/red"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            android:background="@drawable/btn_rectangle_outline_bg_red"

             android:textColor="@color/red"
              android:layout_marginBottom="@dimen/dimen_40dp"
            android:textAlignment="center"
            android:layout_alignParentBottom="true"
            android:text="@string/continue_string"/>
    </RelativeLayout>
</androidx.appcompat.widget.LinearLayoutCompat>