<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <EditText
        android:id="@+id/edSearchTractorByBrand"
        style="@style/EditViewOutlineSearch"
        android:layout_width="match_parent"
        android:clickable="true"
        android:minHeight="@dimen/dimen_50dp"
        android:enabled="true"
        android:focusable="true"
        android:paddingStart="@dimen/dimen_10dp"
        android:paddingEnd="@dimen/dimen_4dp"
        android:layout_marginEnd="@dimen/dimen_10dp"
        android:layout_height="@dimen/dimen_50dp"
        android:layout_marginStart="@dimen/dimen_10dp"
        android:hint="@string/type_to_select_tractor_name"
        android:inputType="textPersonName"
        android:autofillHints="">

    </EditText>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/newTractorSearchRes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dimen_20dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="@dimen/dimen_5dp"
        android:layout_marginEnd="@dimen/dimen_5dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"/>
    <include
        android:id="@+id/llProgress"
        layout="@layout/progressbar"/>
</LinearLayout>
